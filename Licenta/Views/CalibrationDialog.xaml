<Window x:Class="WifiSignalOptimizer.Dialogs.CalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrare Scară"
        Height="423" Width="497"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D0D0F"
        BorderBrush="#2A2A35"
        BorderThickness="1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0"
                Background="#151518"
                BorderBrush="#2A2A35"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="#3B82F6"/>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="8" ShadowDepth="0"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="CALIBRARE SCARĂ"
                           FontSize="10" FontFamily="Consolas" FontWeight="Bold"
                           Foreground="#3B82F6" VerticalAlignment="Center"/>
                <TextBlock Text=" · Distanță reală"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="#5A5A72" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Content ── -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0">

            <!-- Instrucțiune -->
            <TextBlock Text="Ai desenat o linie pe hartă. Introdu distanța reală corespunzătoare."
                       FontSize="12" FontFamily="Segoe UI"
                       Foreground="#8888AA" TextWrapping="Wrap"
                       Margin="0,0,0,20" LineHeight="18"/>

            <!-- Input row -->
            <Border Background="#151518" CornerRadius="8"
                    BorderBrush="#2A2A35" BorderThickness="1"
                    Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="DISTANȚA REALĂ" FontSize="8" FontFamily="Consolas"
                                   FontWeight="Bold" Foreground="#5A5A72" Margin="0,0,0,4"/>
                        <TextBlock Text="Cât măsoară linia trasată în realitate?"
                                   FontSize="11" FontFamily="Segoe UI" Foreground="#8888AA"/>
                    </StackPanel>
                    <TextBox x:Name="MetersInput"
                             Grid.Column="1"
                             Width="80" Height="38"
                             FontSize="20" FontWeight="Bold"
                             FontFamily="Consolas"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Text="5.0"
                             Background="#0D0D0F"
                             Foreground="#F0F0F5"
                             BorderBrush="#3B82F6"
                             BorderThickness="1"
                             CaretBrush="#3B82F6"
                             Margin="12,0,0,0">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Grid.Column="2"
                               Text="m"
                               FontSize="14" FontFamily="Consolas"
                               FontWeight="Bold"
                               Foreground="#5A5A72"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Exemple card -->
            <Border Background="#1A1A2A" CornerRadius="6"
                    BorderBrush="#2A2A35" BorderThickness="1"
                    Padding="14,10">
                <StackPanel>
                    <TextBlock Text="EXEMPLE COMUNE" FontSize="8" FontFamily="Consolas"
                               FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Col 1 -->
                        <Border Grid.Column="0" Background="#0D0D14" CornerRadius="4"
                                Padding="8,6" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Perete" FontSize="10" FontFamily="Consolas"
                                           Foreground="#5A5A72"/>
                                <TextBlock Text="4–5 m" FontSize="13" FontWeight="Bold"
                                           FontFamily="Consolas" Foreground="#F0F0F5"/>
                            </StackPanel>
                        </Border>
                        <!-- Col 2 -->
                        <Border Grid.Column="1" Background="#0D0D14" CornerRadius="4"
                                Padding="8,6" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Cameră" FontSize="10" FontFamily="Consolas"
                                           Foreground="#5A5A72"/>
                                <TextBlock Text="3–6 m" FontSize="13" FontWeight="Bold"
                                           FontFamily="Consolas" Foreground="#F0F0F5"/>
                            </StackPanel>
                        </Border>
                        <!-- Col 3 -->
                        <Border Grid.Column="2" Background="#0D0D14" CornerRadius="4"
                                Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="Ușă" FontSize="10" FontFamily="Consolas"
                                           Foreground="#5A5A72"/>
                                <TextBlock Text="~0.9 m" FontSize="13" FontWeight="Bold"
                                           FontFamily="Consolas" Foreground="#F0F0F5"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── Footer Buttons ── -->
        <Border Grid.Row="2"
                Background="#0A0A10"
                BorderBrush="#2A2A35"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="Anulează"
                        Width="100" Height="34"
                        Cursor="Hand"
                        Click="Cancel_Click"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1A1A1F"/>
                            <Setter Property="Foreground" Value="#8888AA"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="FontSize"   Value="12"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#2A2A35"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#22222A"/>
                                                <Setter Property="Foreground" Value="#F0F0F5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="  ✓  Confirmă"
                        Width="120" Height="34"
                        Cursor="Hand"
                        Click="OK_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3B82F6"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="FontSize"   Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
