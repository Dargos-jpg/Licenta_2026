<UserControl x:Class="WifiSignalOptimizer.Views.DoctorPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#0D0D0F">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DPBgCard"    Color="#151518"/>
        <SolidColorBrush x:Key="DPBorder"    Color="#2A2A35"/>
        <SolidColorBrush x:Key="DPTextPrimary" Color="#F0F0F5"/>
        <SolidColorBrush x:Key="DPTextMuted" Color="#5A5A72"/>
        <SolidColorBrush x:Key="DPTextSub"   Color="#8888AA"/>
        <SolidColorBrush x:Key="DPBgSection" Color="#1A1A1F"/>

        <Style x:Key="DPMinimalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3B82F6" CornerRadius="2" Opacity="0.6"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DPScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar Grid.Column="1"
                                       Style="{StaticResource DPMinimalScrollBar}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Hero score -->
            <RowDefinition Height="*"/>     <!-- Content 3 col -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Grid.Row="0" Background="#101014"
                BorderBrush="{StaticResource DPBorder}" BorderThickness="0,0,0,1"
                Padding="20,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#3B82F6" BlurRadius="8" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="DOCTOR WI-FI" FontSize="10" FontFamily="Consolas"
                               Foreground="#3B82F6" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" · Raport Diagnostic Avansat" FontSize="10" FontFamily="Consolas"
                               Foreground="{StaticResource DPTextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TimestampText" Text="–" HorizontalAlignment="Right"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource DPTextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ HERO SCORE BAR ══ -->
        <Border Grid.Row="1" Background="{StaticResource DPBgCard}"
                BorderBrush="{StaticResource DPBorder}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Score Circle -->
                <Grid Grid.Column="0" Width="70" Height="70">
                    <Ellipse Width="70" Height="70" StrokeThickness="3">
                        <Ellipse.Stroke>
                            <SolidColorBrush x:Name="ScoreRingBrush" Color="#22C55E"/>
                        </Ellipse.Stroke>
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#151518"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="ScoreGlow" Color="#22C55E" BlurRadius="14" ShadowDepth="0" Opacity="0.5"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ScoreText" Text="—" FontSize="22" FontWeight="Black"
                                   FontFamily="Segoe UI" HorizontalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="ScoreTextBrush" Color="#22C55E"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="/100" FontSize="8" Foreground="{StaticResource DPTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- SSID + Classification -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Border Background="#22C55E22" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock x:Name="ClassificationText" Text="Excelent"
                                       FontSize="9" FontFamily="Consolas" FontWeight="Bold">
                                <TextBlock.Foreground>
                                    <SolidColorBrush x:Name="ClassBrush" Color="#22C55E"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <Border Background="#3B82F622" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="BandText" Text="5 GHz"
                                       FontSize="9" FontFamily="Consolas" FontWeight="Bold" Foreground="#3B82F6"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SsidText" Text="—" FontSize="18" FontWeight="Bold"
                               FontFamily="Segoe UI" Foreground="{StaticResource DPTextPrimary}"/>
                    <TextBlock x:Name="BandCharText" Text="—" FontSize="11"
                               Foreground="{StaticResource DPTextSub}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Stats Pills -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource DPBgSection}" CornerRadius="7" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SEMNAL" FontSize="8" FontFamily="Consolas"
                                       Foreground="{StaticResource DPTextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SignalText" Text="—" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush x:Name="SignalBrush" Color="#22C55E"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="dBm" FontSize="8" Foreground="{StaticResource DPTextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource DPBgSection}" CornerRadius="7" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="VITEZĂ" FontSize="8" FontFamily="Consolas"
                                       Foreground="{StaticResource DPTextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SpeedText" Text="—" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource DPTextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SpeedMaxText" Text="— max" FontSize="8"
                                       Foreground="{StaticResource DPTextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource DPBgSection}" CornerRadius="7" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CANAL" FontSize="8" FontFamily="Consolas"
                                       Foreground="{StaticResource DPTextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ChannelText" Text="—" FontSize="16" FontWeight="Bold"
                                       Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock x:Name="ChannelOptimalText" Text="actual" FontSize="8"
                                       Foreground="{StaticResource DPTextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource DPBgSection}" CornerRadius="7" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CONG." FontSize="8" FontFamily="Consolas"
                                       Foreground="{StaticResource DPTextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CongestionText" Text="—" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource DPTextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="0-100" FontSize="8" Foreground="{StaticResource DPTextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ MAIN CONTENT (3 coloane) ══ -->
        <Grid Grid.Row="2" Margin="14,12,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- COL 1: Canale + Vecini -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource DPBgCard}"
                        BorderBrush="{StaticResource DPBorder}" BorderThickness="1"
                        CornerRadius="9" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="ANALIZĂ CANALE" FontSize="8" FontFamily="Consolas"
                                       Foreground="{StaticResource DPTextMuted}" FontWeight="Bold"/>
                            <TextBlock Text="Clustering K-Means" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DPTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource DPScrollViewer}">
                            <ItemsControl x:Name="ChannelsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="8,5" CornerRadius="5" Background="#1A1A1F">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Channel, StringFormat='CH{0}'}"
                                                           FontFamily="Consolas" FontSize="10"
                                                           FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}"
                                                           FontSize="10" Foreground="#A0A0C0"
                                                           VerticalAlignment="Center" Margin="4,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding InterferenceScore, StringFormat='{}{0:F0}'}"
                                                           FontFamily="Consolas" FontSize="9"
                                                           Foreground="#5A5A72" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource DPBgCard}"
                        BorderBrush="{StaticResource DPBorder}" BorderThickness="1"
                        CornerRadius="9" Padding="14" MaxHeight="160">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="VECINI PROBLEMATICI" FontSize="8" FontFamily="Consolas"
                                       Foreground="{StaticResource DPTextMuted}" FontWeight="Bold"/>
                            <TextBlock x:Name="NeighborCountText" Text="— rețele detectate"
                                       FontSize="11" Foreground="{StaticResource DPTextSub}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource DPScrollViewer}">
                            <ItemsControl x:Name="NeighborsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SSID}" FontSize="10"
                                                       Foreground="#A0A0C0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SignalStrength, StringFormat='{}{0} dB'}"
                                                       FontFamily="Consolas" FontSize="9"
                                                       Foreground="#6060A0" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" CornerRadius="3" Padding="3,1"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                                    Background="#EF444420">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EF444420"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ThreatLevel}" Value="Mediu">
                                                                <Setter Property="Background" Value="#F9731620"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ThreatLevel}" Value="Scăzut">
                                                                <Setter Property="Background" Value="#EAB30820"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ThreatLevel}" FontSize="8" FontFamily="Consolas">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ThreatLevel}" Value="Mediu">
                                                                    <Setter Property="Foreground" Value="#F97316"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ThreatLevel}" Value="Scăzut">
                                                                    <Setter Property="Foreground" Value="#EAB308"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- COL 2: Grafic Interferențe -->
            <Border Grid.Column="2" Background="{StaticResource DPBgCard}"
                    BorderBrush="{StaticResource DPBorder}" BorderThickness="1"
                    CornerRadius="9" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="HARTĂ INTERFERENȚE" FontSize="8" FontFamily="Consolas"
                                       Foreground="{StaticResource DPTextMuted}" FontWeight="Bold"/>
                            <TextBlock Text="Scor interferență per canal" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DPTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                            <Ellipse Width="5" Height="5" Fill="#3B82F6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Canal curent" FontSize="9" Foreground="{StaticResource DPTextSub}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Ellipse Width="5" Height="5" Fill="#22C55E" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Canal optim" FontSize="9" Foreground="{StaticResource DPTextSub}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Canvas x:Name="InterferenceChart" Grid.Row="1" Background="Transparent"/>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SCOR SĂNĂTATE REȚEA" FontSize="8" FontFamily="Consolas"
                                       Foreground="{StaticResource DPTextMuted}"/>
                            <TextBlock x:Name="HealthPctText" Grid.Column="1" Text="—%"
                                       FontSize="8" FontFamily="Consolas" Foreground="{StaticResource DPTextSub}"/>
                        </Grid>
                        <Border Grid.Row="1" Height="5" CornerRadius="3" Background="#1A1A2E" Margin="0,4,0,0">
                            <Border x:Name="HealthBar" Height="5" CornerRadius="3"
                                    HorizontalAlignment="Left" Width="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop x:Name="HealthBarGrad" Color="#22C55E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- COL 3: Recomandări + Probleme -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource DPBgCard}"
                        BorderBrush="{StaticResource DPBorder}" BorderThickness="1"
                        CornerRadius="9" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="RECOMANDĂRI AI" FontSize="8" FontFamily="Consolas"
                                       Foreground="#3B82F6" FontWeight="Bold"/>
                            <TextBlock Text="Acțiuni sugerate" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DPTextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource DPScrollViewer}">
                            <ItemsControl x:Name="InsightsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" FontFamily="Segoe UI"
                                                   Foreground="#C0C0D8" Margin="0,3" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource DPBgCard}"
                        BorderBrush="{StaticResource DPBorder}" BorderThickness="1"
                        CornerRadius="9" Padding="14" MaxHeight="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="PROBLEME DETECTATE" FontSize="8" FontFamily="Consolas"
                                       Foreground="{StaticResource DPTextMuted}" FontWeight="Bold"/>
                            <TextBlock x:Name="IssueCountText" Text="0 probleme găsite"
                                       FontSize="11" Foreground="{StaticResource DPTextSub}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource DPScrollViewer}">
                            <ItemsControl x:Name="IssuesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" Padding="10,7" CornerRadius="6" Background="#1A1A1F">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold"
                                                               Foreground="#E0E0F0" TextWrapping="Wrap"/>
                                                    <Border CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#EF444420"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Medie">
                                                                        <Setter Property="Background" Value="#F9731620"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Informativă">
                                                                        <Setter Property="Background" Value="#3B82F620"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Severity}" FontSize="8" FontFamily="Consolas">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Medie">
                                                                            <Setter Property="Foreground" Value="#F97316"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Informativă">
                                                                            <Setter Property="Foreground" Value="#3B82F6"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="10"
                                                           Foreground="#7070A0" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══ FOOTER ══ -->
        <Border Grid.Row="3" Background="#0A0A10"
                BorderBrush="{StaticResource DPBorder}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="EfficiencyText" Text="Eficiență rețea: —%"
                               FontSize="10" FontFamily="Consolas" Foreground="{StaticResource DPTextMuted}" Margin="0,0,20,0"/>
                    <TextBlock x:Name="NeighborSummaryText" Text="— vecini în zonă"
                               FontSize="10" FontFamily="Consolas" Foreground="{StaticResource DPTextMuted}" Margin="0,0,20,0"/>
                    <TextBlock x:Name="CanalOptimText" Text="Canal optim: —"
                               FontSize="10" FontFamily="Consolas" Foreground="{StaticResource DPTextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
