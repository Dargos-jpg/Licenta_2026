<Window x:Class="WifiSignalOptimizer.Views.DoctorReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Doctor Wi-Fi · Raport Avansat"
        Height="720" Width="1100" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0F"
        AllowsTransparency="False"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- ══ CULORI ══ -->
        <SolidColorBrush x:Key="BgBase"      Color="#0D0D0F"/>
        <SolidColorBrush x:Key="BgCard"      Color="#151518"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#1C1C21"/>
        <SolidColorBrush x:Key="BgSection"   Color="#1A1A1F"/>
        <SolidColorBrush x:Key="Border"      Color="#2A2A35"/>
        <SolidColorBrush x:Key="Accent"      Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentGlow"  Color="#60A5FA"/>
        <SolidColorBrush x:Key="Green"       Color="#22C55E"/>
        <SolidColorBrush x:Key="Yellow"      Color="#EAB308"/>
        <SolidColorBrush x:Key="Orange"      Color="#F97316"/>
        <SolidColorBrush x:Key="Red"         Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F5"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#5A5A72"/>
        <SolidColorBrush x:Key="TextSub"     Color="#8888AA"/>

        <!-- ══ SCROLLBAR MINIMALISTĂ ══ -->
        <Style x:Key="MinimalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3B82F6" CornerRadius="2" Opacity="0.6"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimalScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar Grid.Column="1"
                                       Style="{StaticResource MinimalScrollBar}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ CLOSE BUTTON ══ -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title bar -->
            <RowDefinition Height="Auto"/>
            <!-- Hero score bar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════ -->
        <!--  TITLE BAR                                         -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#10101400"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#3B82F6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#3B82F6" BlurRadius="8" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="DOCTOR WI-FI" FontSize="11" FontFamily="Consolas"
                               Foreground="#3B82F6" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" · Raport Diagnostic Avansat"
                               FontSize="11" FontFamily="Consolas"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TimestampText"
                           Text="–"
                           HorizontalAlignment="Right"
                           FontSize="11" FontFamily="Consolas"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════ -->
        <!--  HERO SCORE BAR                                    -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Score ring -->
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <!-- SSID + meta -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Stats pills -->
                </Grid.ColumnDefinitions>

                <!-- Score Circle -->
                <Grid Grid.Column="0" Width="80" Height="80">
                    <Ellipse Width="80" Height="80">
                        <Ellipse.Stroke>
                            <SolidColorBrush x:Name="ScoreRingBrush" Color="#22C55E"/>
                        </Ellipse.Stroke>
                        <Ellipse.StrokeThickness>3</Ellipse.StrokeThickness>
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#151518"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="ScoreGlow" Color="#22C55E" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ScoreText" Text="—"
                                   FontSize="26" FontWeight="Black"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="ScoreTextBrush" Color="#22C55E"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="/100" FontSize="9" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- SSID + Classification -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border x:Name="ClassificationBadge"
                                Background="#22C55E22" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                            <TextBlock x:Name="ClassificationText" Text="Excelent"
                                       FontSize="10" FontFamily="Consolas" FontWeight="Bold">
                                <TextBlock.Foreground>
                                    <SolidColorBrush x:Name="ClassBrush" Color="#22C55E"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                        <Border x:Name="BandBadge"
                                Background="#3B82F622" CornerRadius="4" Padding="8,2">
                            <TextBlock x:Name="BandText" Text="5 GHz"
                                       FontSize="10" FontFamily="Consolas" FontWeight="Bold"
                                       Foreground="#3B82F6"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SsidText" Text="—"
                               FontSize="22" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="BandCharText" Text="—"
                               FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Stats pills -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- Signal pill -->
                    <Border Background="{StaticResource BgSection}" CornerRadius="8" Padding="16,10" Margin="0,0,10,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SEMNAL" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SignalText" Text="—" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush x:Name="SignalBrush" Color="#22C55E"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="dBm" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Speed pill -->
                    <Border Background="{StaticResource BgSection}" CornerRadius="8" Padding="16,10" Margin="0,0,10,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="VITEZĂ" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SpeedText" Text="—" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SpeedMaxText" Text="— max" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Channel pill -->
                    <Border Background="{StaticResource BgSection}" CornerRadius="8" Padding="16,10" Margin="0,0,10,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CANAL" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ChannelText" Text="—" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock x:Name="ChannelOptimalText" Text="actual" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Congestion pill -->
                    <Border Background="{StaticResource BgSection}" CornerRadius="8" Padding="16,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CONGESTIONARE" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CongestionText" Text="—" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="indice 0-100" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════ -->
        <!--  MAIN CONTENT: 3 COLOANE                           -->
        <!-- ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <!-- Coloane canale + vecini -->
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <!-- Grafic interferență -->
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="280"/>
                <!-- Recomandări + probleme -->
            </Grid.ColumnDefinitions>

            <!-- ── COL 1: Canale + Vecini ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Card Canale (K-Means) -->
                <Border Grid.Row="0" Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="ANALIZĂ CANALE" FontSize="9" FontFamily="Consolas"
                                       Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                            <TextBlock Text="Clustering K-Means" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource MinimalScrollViewer}">
                            <ItemsControl x:Name="ChannelsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="10,6" CornerRadius="6"
                                                Background="#1A1A1F">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Channel, StringFormat='CH{0}'}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           FontWeight="Bold" Foreground="#3B82F6"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Status}"
                                                           FontSize="11" Foreground="#A0A0C0"
                                                           VerticalAlignment="Center" Margin="4,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding InterferenceScore, StringFormat='{}{0:F0}'}"
                                                           FontFamily="Consolas" FontSize="10"
                                                           Foreground="#5A5A72" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Card Vecini Problematici -->
                <Border Grid.Row="2" Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="16" MaxHeight="180">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="VECINI PROBLEMATICI" FontSize="9" FontFamily="Consolas"
                                       Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                            <TextBlock x:Name="NeighborCountText" Text="— rețele detectate"
                                       FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource MinimalScrollViewer}">
                            <ItemsControl x:Name="NeighborsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3" Height="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SSID}"
                                                       FontSize="11" Foreground="#A0A0C0"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SignalStrength, StringFormat='{}{0} dB'}"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="#6060A0" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" CornerRadius="3" Padding="4,1"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EF444420"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ThreatLevel}" Value="Mediu">
                                                                <Setter Property="Background" Value="#F9731620"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ThreatLevel}" Value="Scăzut">
                                                                <Setter Property="Background" Value="#EAB30820"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ThreatLevel}" FontSize="9"
                                                           FontFamily="Consolas">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ThreatLevel}" Value="Mediu">
                                                                    <Setter Property="Foreground" Value="#F97316"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ThreatLevel}" Value="Scăzut">
                                                                    <Setter Property="Foreground" Value="#EAB308"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── COL 2: Grafic Interferență ── -->
            <Border Grid.Column="2" Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="HARTĂ INTERFERENȚE" FontSize="9" FontFamily="Consolas"
                                       Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                            <TextBlock Text="Scor de interferență per canal" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,0,0">
                            <!-- Legend -->
                            <Ellipse Width="6" Height="6" Fill="#3B82F6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Canal curent" FontSize="10" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Canal optim" FontSize="10" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Grafic bare interferență -->
                    <Canvas x:Name="InterferenceChart" Grid.Row="1" Background="Transparent"/>

                    <!-- Health Progress Bar -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SCOR SĂNĂTATE REȚEA" FontSize="9" FontFamily="Consolas"
                                       Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="HealthPctText" Grid.Column="1"
                                       Text="—%" FontSize="9" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSub}"/>
                        </Grid>
                        <Border Grid.Row="1" Height="6" CornerRadius="3"
                                Background="#1A1A2E" Margin="0,4,0,0">
                            <Border x:Name="HealthBar" Height="6" CornerRadius="3"
                                    HorizontalAlignment="Left" Width="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop x:Name="HealthBarGrad" Color="#22C55E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── COL 3: Recomandări + Probleme ── -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Recomandări -->
                <Border Grid.Row="0" Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="RECOMANDĂRI AI" FontSize="9" FontFamily="Consolas"
                                       Foreground="#3B82F6" FontWeight="Bold"/>
                            <TextBlock Text="Acțiuni sugerate" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource MinimalScrollViewer}">
                            <ItemsControl x:Name="InsightsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" Padding="10,8" CornerRadius="6"
                                                Background="#1A1A2A">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                       FontSize="12" Foreground="#B0B0D0"
                                                       LineHeight="18"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Probleme detectate -->
                <Border Grid.Row="2" Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="16" MaxHeight="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="PROBLEME DETECTATE" FontSize="9" FontFamily="Consolas"
                                       Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                            <TextBlock x:Name="IssueCountText" Text="— probleme"
                                       FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource MinimalScrollViewer}">
                            <ItemsControl x:Name="IssuesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" Padding="10,8" CornerRadius="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EF444410"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Medie">
                                                            <Setter Property="Background" Value="#F9731610"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Informativă">
                                                            <Setter Property="Background" Value="#3B82F610"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding Severity}"
                                                               FontSize="9" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,8,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Medie">
                                                                        <Setter Property="Foreground" Value="#F97316"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Informativă">
                                                                        <Setter Property="Foreground" Value="#3B82F6"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Title}" FontSize="11"
                                                               FontWeight="SemiBold" Foreground="#D0D0E8" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="10"
                                                           Foreground="{StaticResource TextSub}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════ -->
        <!--  FOOTER                                            -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                Padding="24,14,24,14" Margin="0,12,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="EfficiencyText" Text="Eficiență rețea: —%"
