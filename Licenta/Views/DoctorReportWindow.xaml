                    <TextBlock Text=" · " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    <TextBlock x:Name="NeighborSummaryText" Text="— vecini în zonă"
                               FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextSub}"/>
                    <TextBlock Text=" · " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    <TextBlock x:Name="CanalOptimText" Text="Canal optim: —"
