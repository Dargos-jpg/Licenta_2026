<Window x:Class="WifiSignalOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WiFi Signal Optimizer"
        Height="820" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Convertor invers: true→Collapsed, false→Visible (pentru Mod Basic banner) -->
        <Style x:Key="ExpertOnlyVisibility" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BasicOnlyVisibility" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Grid brush pentru drawing overlay -->
        <DrawingBrush x:Key="GridBrush" Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2A2A2A" Thickness="0.5"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,20,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar fix, lățime VS Code -->
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- SIDEBAR STÂNGA                                              -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{StaticResource BgPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="Auto"/>  <!-- Mode toggle -->
                <RowDefinition Height="*"/>     <!-- Scrollable content -->
                <RowDefinition Height="Auto"/>  <!-- Status bar bottom -->
            </Grid.RowDefinitions>

            <!-- ── Title bar ── -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSection}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📡"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="WiFi Signal Optimizer"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="Proiect Licență"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Mode Toggle Bar ── -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgBase}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Buton Basic -->
                    <Button Grid.Column="0"
                            Padding="0,6"
                            Margin="2"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="SetBasicMode_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent">
                                                <TextBlock x:Name="txt"
                                                           Text="BASIC"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           FontFamily="Segoe UI"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#9D9D9D"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsExpertMode}" Value="False">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Buton Expert -->
                    <Button Grid.Column="1"
                            Padding="0,6"
                            Margin="2"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="SetExpertMode_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent">
                                                <TextBlock x:Name="txt"
                                                           Text="EXPERT"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           FontFamily="Segoe UI"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#9D9D9D"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Scrollable sidebar content ── -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,4,0,4">

                    <!-- ╔═══════════════════════════════╗ -->
                    <!-- ║  SECȚIUNEA: HARTĂ             ║ -->
                    <!-- ╚═══════════════════════════════╝ -->
                    <Expander Style="{StaticResource SidebarExpander}"
                              IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="HARTĂ"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="8,4,8,8">
                            <Button Content="  📂  Încarcă Plan"
                                    
                                    Command="{Binding LoadMapCommand}"/>
                            <Button Content="  ✏️  Creează Schiță Nouă"
                                    
                                    Click="StartSketch_Click"/>
                            <!-- Expert only -->
                            <Button Content="  📏  Calibrează Scara"
                                    
                                    Click="StartCalibration_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Calibration status — expert only -->
                            <Border Margin="4,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Danger}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="11"
                                               FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondary}"
                                               Text="{Binding PixelsPerMeter, StringFormat='Scară: {0:F1} px/m'}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,2"/>

                    <!-- ╔═══════════════════════════════╗ -->
                    <!-- ║  SECȚIUNEA: SCANARE WiFi      ║ -->
                    <!-- ╚═══════════════════════════════╝ -->
                    <Expander Style="{StaticResource SidebarExpander}"
                              IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="SCANARE WiFi"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="8,4,8,8">
                            <Button Content="  📡  Scanează Rețele"
                                    Style="{StaticResource SidebarButton}"
                                    Command="{Binding ScanCommand}"
                                    IsEnabled="{Binding IsScanning, Converter={StaticResource InvertBoolConverter}}"/>
                            <Button Content="  🩺  Diagnostichează Rețeaua"
                                    Style="{StaticResource SidebarButton}"
                                    Command="{Binding AnalyzeNetworkCommand}"/>

                            <!-- Auto-Scan toggle — Expert only -->
                            <Button 
                                    Content="{Binding AutoScanButtonText}"
                                    Command="{Binding ToggleAutoScanCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAutoScanning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Survey counter -->
                            <TextBlock Margin="4,6,0,0"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondary}"
                                       Text="{Binding SurveyPointCount, StringFormat='  {0} puncte înregistrate'}"/>

                            <!-- ══════════════════════════════════ -->
                            <!-- LISTA REȚELE — MOD BASIC          -->
                            <!-- Listă simplă: iconiță + nume + bar -->
                            <!-- ══════════════════════════════════ -->
                            <Border Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Rețele detectate"
                                               FontSize="10"
                                               FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="2,0,0,4"/>
                                    <ListBox ItemsSource="{Binding VisibleNetworks}"
                                             SelectedItem="{Binding SelectedNetwork}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             MaxHeight="220"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource NetworkItemBasic}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="📶"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SSID}"
                                                               FontSize="12"
                                                               FontFamily="Segoe UI"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Grid.Column="2" 
                                                                 Value="{Binding SignalQuality, Mode=OneWay}" 
                                                                 Height="4" 
                                                                 VerticalAlignment="Center" 
                                                                 Margin="6,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- ══════════════════════════════════ -->
                            <!-- TABEL REȚELE — MOD EXPERT         -->
                            <!-- dBm, Canal, Signal Quality        -->
                            <!-- ══════════════════════════════════ -->
                            <Border Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DataGrid ItemsSource="{Binding VisibleNetworks}"
                                          SelectedItem="{Binding SelectedNetwork}"
                                          MaxHeight="220"
                                          FontFamily="Consolas"
                                          FontSize="11">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SSID"
                                                            Binding="{Binding SSID}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="dBm"
                                                            Binding="{Binding SignalStrength}"
                                                            Width="42"/>
                                        <DataGridTextColumn Header="Ch"
                                                            Binding="{Binding Channel}"
                                                            Width="32"/>
                                        <DataGridTemplateColumn Header="Sig" Width="44">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ProgressBar Value="{Binding SignalQuality, Mode=OneWay}" 
                                                                 Height="4" 
                                                                 Margin="2,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,2"/>

                    <!-- ╔═══════════════════════════════╗ -->
                    <!-- ║  SECȚIUNEA: ANALIZĂ (EXPERT)  ║ -->
                    <!-- ╚═══════════════════════════════╝ -->
                    <Expander 
                              IsExpanded="False">
                        <Expander.Style>
                            <Style TargetType="Expander" BasedOn="{StaticResource SidebarExpander}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <TextBlock Text="ANALIZĂ AVANSATĂ"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="8,4,8,8">
                            <Button Content="  🔥  Generează Heatmap"
                                    Style="{StaticResource SidebarButton}"
                                    Command="{Binding GenerateHeatmapCommand}"/>
                            <Button Content="  ⭐  Poziție Optimă Router (Min-Max)"
                                    Style="{StaticResource SidebarButton}"
                                    Command="{Binding CalculateOptimalRouterCommand}"
                                    ToolTip="Algoritmul Min-Max garantează semnal uniform în toată casa."/>
                        </StackPanel>
                    </Expander>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,2"/>

                    <!-- ╔═══════════════════════════════╗ -->
                    <!-- ║  SECȚIUNEA: PROIECT           ║ -->
                    <!-- ╚═══════════════════════════════╝ -->
                    <Expander Style="{StaticResource SidebarExpander}"
                              IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="PROIECT"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="8,4,8,8">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="  💾  Salvare"
                                        Style="{StaticResource AccentButton}"
                                        Command="{Binding SaveProjectCommand}"
                                        Padding="8,7"/>
                                <Button Grid.Column="2"
                                        Content="  📥  Încărcare"
                                        Style="{StaticResource SidebarButton}"
                                        Command="{Binding LoadProjectCommand}"
                                        Padding="8,7"/>
                            </Grid>
                            <Button Content="  🗑️  Șterge Toate Punctele"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding ClearSurveyPointsCommand}"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Status bar ── -->
            <Border Grid.Row="3"
                    Background="{StaticResource Accent}"
                    Padding="10,4">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ZONA PRINCIPALĂ — HARTĂ                                     -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{StaticResource BgBase}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar hartă -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSection}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Hartă Plan de Încadrare"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="14,0"/>
                    <TextBlock Text="{Binding SurveyPointCount, StringFormat='{}{0} puncte'}"
                               FontSize="11"
                               FontFamily="Segoe UI"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Canvas hartă -->
            <ScrollViewer Grid.Row="1"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource BgBase}">
                <Canvas x:Name="MapCanvas"
                        MouseWheel="MapCanvas_MouseWheel"
                        Background="Transparent">
                    <Grid x:Name="MapContent"
                          MouseLeftButtonDown="MapContent_MouseLeftButtonDown"
                          MouseRightButtonDown="MapContent_MouseRightButtonDown"
                          MouseMove="MapContent_MouseMove"
                          MouseLeftButtonUp="MapContent_MouseLeftButtonUp"
                          Background="Transparent"
                          Cursor="Hand">

                        <Image x:Name="FloorPlanImage"
                               Source="{Binding FloorPlan}"
                               Stretch="None"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>

                        <Image Source="{Binding HeatmapOverlay}"
                               Width="{Binding ElementName=FloorPlanImage, Path=ActualWidth}"
                               Height="{Binding ElementName=FloorPlanImage, Path=ActualHeight}"
                               Stretch="Fill"
                               IsHitTestVisible="False"
                               Opacity="0.7"/>

                        <Canvas x:Name="SurveyPointsCanvas"
                                Background="Transparent"/>
                    </Grid>
                </Canvas>
            </ScrollViewer>

            <!-- DRAWING OVERLAY -->
            <Grid x:Name="DrawingOverlay"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Background="{StaticResource BgBase}">

                <Border Background="{StaticResource GridBrush}"
                        Opacity="0.4"
                        Panel.ZIndex="0"/>

                <InkCanvas x:Name="EditorCanvas"
                           Background="Transparent"
                           MouseLeftButtonDown="EditorCanvas_MouseDown"
                           MouseMove="EditorCanvas_MouseMove"
                           MouseLeftButtonUp="EditorCanvas_MouseUp"
                           Panel.ZIndex="1">
                    <InkCanvas.DefaultDrawingAttributes>
                        <DrawingAttributes Color="#D4D4D4" Height="3" Width="3" FitToCurve="False"/>
                    </InkCanvas.DefaultDrawingAttributes>
                </InkCanvas>

                <Canvas x:Name="ObjectsCanvas"
                        Background="{x:Null}"
                        IsHitTestVisible="True"
                        Panel.ZIndex="2"/>

                <Line x:Name="PreviewLine"
                      Stroke="#007ACC"
                      StrokeThickness="1.5"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"
                      Panel.ZIndex="100"/>

                <!-- Drawing toolbar -->
                <Border VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Background="{StaticResource BgSection}"
                        CornerRadius="6"
                        Padding="14,10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Panel.ZIndex="200">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" Opacity="0.6" BlurRadius="12" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Drawing tools row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="UNELTE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <RadioButton Content="Perete"
                                         GroupName="Tools"
                                         IsChecked="True"
                                         Click="Tool_Wall_Click"
                                         Foreground="{StaticResource TextPrimary}"
                                         Margin="0,0,8,0"
                                         FontFamily="Segoe UI"
                                         FontSize="12"/>
                            <RadioButton Content="Detalii"
                                         GroupName="Tools"
                                         Click="Tool_Detail_Click"
                                         Foreground="{StaticResource TextPrimary}"
                                         Margin="0,0,8,0"
                                         FontFamily="Segoe UI"
                                         FontSize="12"/>
                            <RadioButton Content="Linie Dreaptă"
                                         GroupName="Tools"
                                         Click="Tool_Line_Click"
                                         Foreground="{StaticResource TextPrimary}"
                                         Margin="0,0,8,0"
                                         FontFamily="Segoe UI"
                                         FontSize="12"/>
                            <RadioButton Content="Radieră"
                                         GroupName="Tools"
                                         Click="Tool_Eraser_Click"
                                         Foreground="{StaticResource TextPrimary}"
                                         FontFamily="Segoe UI"
                                         FontSize="12"/>
                        </StackPanel>

                        <!-- Objects row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="OBIECTE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Button Content="Router"
                                    Click="AddRouter_Click"
                                    Style="{StaticResource AccentButton}"
                                    Padding="8,4"
                                    Margin="0,0,4,0"
                                    FontSize="11"/>
                            <Button Content="Frigider"
                                    Click="AddFridge_Click"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,4"
                                    Margin="0,0,4,0"
                                    Background="{StaticResource BgHover}"
                                    FontSize="11"/>
                            <Button Content="Microunde"
                                    Click="AddMicrowave_Click"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,4"
                                    Margin="0,0,4,0"
                                    Background="{StaticResource BgHover}"
                                    FontSize="11"/>
                            <Button Content="Zid Beton"
                                    Click="AddConcreteWall_Click"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,4"
                                    Background="{StaticResource BgHover}"
                                    FontSize="11"/>
                        </StackPanel>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Salvează Schița"
                                    Click="SaveSketch_Click"
                                    Style="{StaticResource AccentButton}"
                                    Padding="12,6"
                                    Margin="0,0,6,0"
                                    FontSize="12"/>
                            <Button Content="Anulează"
                                    Click="CancelSketch_Click"
                                    Style="{StaticResource DangerButton}"
                                    Padding="12,6"
                                    FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hint text bottom -->
                <TextBlock Text="Click dreapta pe hartă pentru a plasa un punct de măsurare  ·  ESC pentru a ieși"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,12"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           Panel.ZIndex="200"/>
            </Grid>

            <!-- Keyboard shortcuts overlay (vizibil când nu e plan încărcat) -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgSection}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,14"
                    Margin="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding FloorPlan, Converter={StaticResource InvertNullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="COMENZI RAPIDE"
                               FontWeight="Bold"
                               FontSize="10"
                               FontFamily="Segoe UI"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,8"/>
                    <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondary}" Margin="0,2" Text="Scroll  →  Zoom In/Out"/>
                    <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondary}" Margin="0,2" Text="Drag    →  Mută harta"/>
                    <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondary}" Margin="0,2" Text="R / Shift+R  →  Rotire"/>
                    <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondary}" Margin="0,2" Text="ESC  →  Resetează poziția"/>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,6"/>
                    <TextBlock FontSize="11"
                               FontFamily="Segoe UI"
                               Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold"
                               Text="Click dreapta  →  Plasează punct"/>
                </StackPanel>
            </Border>

            <!-- Placeholder când nu e niciun plan -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding FloorPlan, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="📋"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock Text="Niciun plan încărcat"
                           FontSize="18"
                           FontFamily="Segoe UI"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Folosește panoul din stânga pentru a încărca un plan sau a crea o schiță nouă."
                           FontSize="12"
                           FontFamily="Segoe UI"
                           Foreground="{StaticResource TextDisabled}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           TextAlignment="Center"
                           MaxWidth="340"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
