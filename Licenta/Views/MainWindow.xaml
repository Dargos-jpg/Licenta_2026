<Window x:Class="WifiSignalOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:views="clr-namespace:WifiSignalOptimizer.Views"
        mc:Ignorable="d"
        Title="WiFi Signal Optimizer"
        Height="820" Width="1400"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DrawingBrush x:Key="GridBrush" Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#BFDBFE" Thickness="0.5"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,20,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="ToolboxButton" TargetType="RadioButton">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="Padding"                  Value="10,6"/>
            <Setter Property="Margin"                   Value="0,1"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolboxSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="9"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="Foreground"   Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin"       Value="10,12,0,4"/>
        </Style>

        <Style x:Key="SectionSep" TargetType="Rectangle">
            <Setter Property="Height"  Value="1"/>
            <Setter Property="Fill"    Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin"  Value="10,0,10,6"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Buton circular "i" pentru mini-ajutor -->
        <Style x:Key="InfoButton" TargetType="Button">
            <Setter Property="Width"           Value="15"/>
            <Setter Property="Height"          Value="15"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Help"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Margin"          Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration"     Value="9000"/>
            <Setter Property="ToolTipService.Placement"        Value="Right"/>
            <Setter Property="ToolTipService.ShowOnDisabled"   Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Width="15" Height="15"
                                Background="#12213A" BorderBrush="#3B82F6" BorderThickness="1">
                            <TextBlock Text="i" FontSize="8" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buton item meniu Opțiuni -->
        <Style x:Key="OptionsMenuItem" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource BgPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BgSection}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#3B82F6"/>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="8" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <StackPanel>
                            <TextBlock Text="WIFI SIGNAL OPTIMIZER"
                                       FontSize="10" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="#3B82F6"/>
                            <TextBlock Text="Proiect Licență · v1.0"
                                       FontSize="10" FontFamily="Consolas"
                                       Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource BgBase}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,8">
                <Border Background="#0D0D0F" CornerRadius="6" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Padding="0,7" Margin="0" Cursor="Hand"
                                BorderThickness="0" Click="SetBasicMode_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="Transparent">
                                                    <TextBlock x:Name="txt" Text="BASIC"
                                                               FontSize="10" FontWeight="Bold"
                                                               FontFamily="Consolas"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{StaticResource TextMuted}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpertMode}" Value="False">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                                        <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1" Padding="0,7" Margin="0" Cursor="Hand"
                                BorderThickness="0" Click="SetExpertMode_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="Transparent">
                                                    <TextBlock x:Name="txt" Text="EXPERT"
                                                               FontSize="10" FontWeight="Bold"
                                                               FontFamily="Consolas"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{StaticResource TextMuted}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                                        <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,6,0,6">

                    <!-- Buton redeschidere wizard — vizibil doar când a fost închis manual în Basic mode -->
                    <Border Margin="10,0,10,6" CornerRadius="6" Padding="0"
                            BorderBrush="#3B82F6" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsWizardMinimized}" Value="True"/>
                                            <Condition Binding="{Binding IsExpertMode}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding ShowWizardCommand}"
                                Background="#0D1A30" Foreground="#60A5FA"
                                BorderThickness="0" Padding="10,7" Cursor="Hand" Width="240">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="HelpCircle" Width="12" Height="12"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                                            Foreground="#60A5FA"/>
                                <TextBlock Text="Redeschide Ghidul Setup"
                                           FontSize="10" FontFamily="Segoe UI"
                                           FontWeight="SemiBold" Foreground="#60A5FA"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Expander Style="{StaticResource SidebarExpander}" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="HARTĂ" FontSize="9" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="10,2,10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SidebarButton}" Command="{Binding LoadMapCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FolderOpen" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Încarcă Plan" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Încarcă o imagine (PNG/JPG) a planului casei sau biroului. Aceasta va fi baza pe care vei plasa puncte de măsurare și obstacole."/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SidebarButton}"
                                        Click="StartDrawOverPlan_Click"
                                        IsEnabled="{Binding HasFloorPlan}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="PencilBox" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Desenează Pereți" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Activează modul desen peste planul încărcat (PNG/JPG). Trage linii drepte peste pereții din imagine — acestea vor fi folosite de simulare pentru atenuarea semnalului."/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SidebarButton}" Click="StartNewGridCanvas_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Grid" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Plan Grilă Nou" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Șterge planul încărcat și creează un canvas alb cu grilă (stil caiet). Util dacă nu ai o imagine sau vrei să desenezi planul de la zero. Scara: 1 pătrățel = 1 metru."/>
                            </Grid>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="StartCalibration_Click" Style="{StaticResource SidebarButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="RulerSquare" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Calibrează Scara" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Calibrează scara planului. Trage o linie peste o distanță cunoscută (ex: un perete de 4m) și introdu distanța reală. Fără calibrare, heatmap-ul folosește o scară estimată de 50 px/m."/>
                            </Grid>

                            <Border Margin="2,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Danger}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="10" FontFamily="Consolas"
                                               Foreground="{StaticResource TextMuted}"
                                               Text="{Binding PixelsPerMeter, StringFormat='Scară: {0:F1} px/m'}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="12,0" Opacity="0.4"/>

                    <Expander Style="{StaticResource SidebarExpander}" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="SCANARE WI-FI" FontSize="9" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="10,2,10,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SidebarButton}"
                                        Command="{Binding ScanCommand}"
                                        IsEnabled="{Binding IsScanning, Converter={StaticResource InvertBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="WifiRefresh" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Scanează Rețele" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Scanează rețelele WiFi disponibile. Detectează SSID, puterea semnalului (dBm) și canalul. Efectuează mai multe scanări pentru date mai precise."/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SidebarButton}"
                                        Command="{Binding AnalyzeNetworkCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Stethoscope" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Diagnostichează Rețeaua" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Deschide Doctor WiFi în zona centrală. Analizează interferențele cu K-Means (ML) și oferă recomandări. Selectează mai întâi o rețea din listă."/>
                            </Grid>
                            <!-- Auto-Scan + selector interval -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding ToggleAutoScanCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAutoScanning}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="PlayPause" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding AutoScanButtonText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Selector interval -->
                                <ComboBox Grid.Column="1" Width="56"
                                          SelectedValue="{Binding AutoScanIntervalSeconds}"
                                          SelectedValuePath="Tag"
                                          FontSize="10" FontFamily="Consolas"
                                          VerticalAlignment="Center" Margin="4,0,0,0"
                                          ToolTip="Interval scanare automată">
                                    <ComboBoxItem Content="2s"  Tag="2"/>
                                    <ComboBoxItem Content="5s"  Tag="5" IsSelected="True"/>
                                    <ComboBoxItem Content="10s" Tag="10"/>
                                    <ComboBoxItem Content="30s" Tag="30"/>
                                </ComboBox>
                            </Grid>

                            <Border Margin="0,6,0,2" Padding="8,4" CornerRadius="4"
                                    Background="#0D0D14" HorizontalAlignment="Left">
                                <TextBlock FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextMuted}"
                                           Text="{Binding SurveyPointCount, StringFormat='  {0} puncte înregistrate'}"/>
                            </Border>

                            <Border Margin="0,6,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="REȚELE DETECTATE" FontSize="9" FontFamily="Consolas"
                                               Foreground="{StaticResource TextMuted}"
                                               FontWeight="Bold" Margin="2,0,0,6"/>
                                    <ListBox ItemsSource="{Binding VisibleNetworks}"
                                             SelectedItem="{Binding SelectedNetwork}"
                                             Background="Transparent" BorderThickness="0"
                                             MaxHeight="180"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource NetworkItemBasic}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="26">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <iconPacks:PackIconMaterial Grid.Column="0" Kind="Wifi"
                                                                                Width="11" Height="11" VerticalAlignment="Center"
                                                                                Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SSID}"
                                                               FontSize="11" FontFamily="Segoe UI"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Margin="4,0"/>
                                                    <ProgressBar Grid.Column="2"
                                                                 Value="{Binding SignalQuality, Mode=OneWay}"
                                                                 Height="3" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,6,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border Background="#0A0A0F" CornerRadius="6" Padding="0" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding VisibleNetworks}"
                                              SelectedItem="{Binding SelectedNetwork}"
                                              MaxHeight="200" FontFamily="Consolas" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SSID" Binding="{Binding SSID}" Width="*"/>
                                            <DataGridTextColumn Header="dBm"  Binding="{Binding SignalStrength}" Width="40"/>
                                            <DataGridTextColumn Header="Ch"   Binding="{Binding Channel}" Width="28"/>
                                            <DataGridTemplateColumn Header="Sig" Width="38">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ProgressBar Value="{Binding SignalQuality, Mode=OneWay}"
                                                                     Height="3" Margin="2,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="12,0" Opacity="0.4"/>

                    <Expander IsExpanded="False">
                        <Expander.Style>
                            <Style TargetType="Expander" BasedOn="{StaticResource SidebarExpander}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <TextBlock Text="ANALIZĂ AVANSATĂ" FontSize="9" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="10,2,10,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SidebarButton}"
                                        Command="{Binding GenerateHeatmapCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="LayersTriple" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Generează Heatmap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Generează harta de intensitate semnal WiFi (heatmap). Verde = semnal excelent (>-50 dBm), Galben = mediu (-50 la -70 dBm), Roșu = slab (&lt;-70 dBm). Necesită minim 2 puncte de măsurare și o rețea selectată."/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SidebarButton}"
                                        Command="{Binding CalculateOptimalRouterCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="RouterWireless" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Poziție Optimă Router (Min-Max)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}"
                                        ToolTip="Algoritmul Min-Max (AI Multi-Criteria) calculează poziția care garantează semnal uniform în toată casa. Ia în calcul pereții, obstacolele și distanțele. După rulare, apare vizualizarea 'Heatmap Optimizat' cu simularea semnalului nou."/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="12,0" Opacity="0.4"/>

                    <Expander Style="{StaticResource SidebarExpander}" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="PROIECT" FontSize="9" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="10,2,10,8">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource AccentButton}"
                                            Command="{Binding SaveProjectCommand}" Padding="8,7">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="ContentSave" Width="13" Height="13"
                                                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Salvare" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource InfoButton}"
                                            ToolTip="Salvează proiectul curent: puncte de măsurare, obstacole, calibrare și schița planului. Fișierul XML poate fi reîncărcat ulterior pentru a continua lucrul."/>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource SidebarButton}"
                                            Command="{Binding LoadProjectCommand}" Padding="8,7">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="TrayArrowDown" Width="13" Height="13"
                                                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Încărcare" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource InfoButton}"
                                            ToolTip="Încarcă un proiect salvat anterior. Restaurează automat punctele, obstacolele, calibrarea și generează heatmap-ul dacă sunt date suficiente."/>
                                </Grid>
                            </Grid>
                            <!-- Undo / Redo -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource SidebarButton}"
                                        Command="{Binding UndoCommand}"
                                        ToolTip="Anulează ultima acțiune (Ctrl+Z)">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Undo" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Undo" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Style="{StaticResource SidebarButton}"
                                        Command="{Binding RedoCommand}"
                                        ToolTip="Reface ultima acțiune (Ctrl+Y)">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Redo" Width="13" Height="13"
                                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Redo" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Export PNG (vizibil când există heatmap) -->
                            <Button Style="{StaticResource SidebarButton}"
                                    Click="ExportHeatmapPng_Click"
                                    Visibility="{Binding HeatmapOverlay, Converter={StaticResource InvertNullToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FileImageOutline" Width="13" Height="13"
                                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Export PNG" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerButton}"
                                    Command="{Binding ClearSurveyPointsCommand}"
                                    ToolTip="Șterge punctele și obstacolele. Planul rămâne încărcat.">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="13" Height="13"
                                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Șterge Toate Punctele" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Reset Complet — ca la pornirea aplicației -->
                            <Button Style="{StaticResource DangerButton}"
                                    Command="{Binding ResetAllCommand}"
                                    ToolTip="Resetează TOT: plan, puncte, obstacole, heatmap. Ca la pornire.">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Restore" Width="13" Height="13"
                                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Reset Complet" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3"
                    Background="#0A0A10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,7"
                    MinHeight="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="5" Height="5" Fill="{StaticResource Accent}"
                             VerticalAlignment="Top" Margin="0,3,7,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#3B82F6" BlurRadius="5" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               FontSize="10" FontFamily="Consolas"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Background="{StaticResource BgBase}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- top bar -->
                <RowDefinition Height="Auto"/>   <!-- wizard Basic mode -->
                <RowDefinition Height="*"/>      <!-- map / views -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BgSection}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="16,14">
                <Grid>
                    <!-- Stânga: info hartă + tool activ + rețea -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hartă Plan de Încadrare"
                                   FontSize="12" FontFamily="Segoe UI"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>

                        <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="14,2" Opacity="0.6"/>

                        <Border Background="#1A1A2E" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SurveyPointCount, StringFormat='{}{0} puncte'}"
                                       FontSize="10" FontFamily="Consolas"
                                       Foreground="{StaticResource TextMuted}"/>
                        </Border>

                        <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="14,2" Opacity="0.6"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}"
                                     VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#3B82F6" BlurRadius="5" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="ActiveToolLabel"
                                       Text="Punct Masurare activ"
                                       FontSize="11" FontFamily="Segoe UI"
                                       Foreground="{StaticResource Accent}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="14,2" Opacity="0.6"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="Wifi" Width="13" Height="13"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="Rețea: "
                                       FontSize="11" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedNetwork.SSID,
                                               TargetNullValue='Nicio retea selectata',
                                               FallbackValue='Nicio retea selectata'}"
                                       FontSize="11" FontFamily="Segoe UI" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}"
                                       VerticalAlignment="Center"/>
                            <!-- Trend semnal continuu -->
                            <TextBlock Text="{Binding SelectedNetworkTrend}"
                                       FontSize="10" FontFamily="Consolas" FontWeight="Bold"
                                       Foreground="#60A5FA" Margin="8,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAutoScanning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Alertă drop semnal -->
                        <Border Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="#2A0A0A" CornerRadius="4" Padding="8,3"
                                BorderBrush="#EF4444" BorderThickness="1"
                                Visibility="{Binding IsSignalAlert, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding SignalAlertMessage}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AlertCircle" Width="11" Height="11"
                                                            VerticalAlignment="Center" Margin="0,0,5,0"
                                                            Foreground="#EF4444"/>
                                <TextBlock Text="{Binding SignalAlertMessage}"
                                           FontSize="10" FontFamily="Consolas"
                                           Foreground="#EF4444" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Buton toggle Dead Zone Overlay (vizibil doar când există heatmap) -->
                        <Border Margin="14,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HeatmapOverlay, Converter={StaticResource InvertNullToVisibilityConverter}}">
                            <ToggleButton IsChecked="{Binding IsDeadZoneOverlayActive}"
                                         Click="ToggleDeadZoneOverlay_Click"
                                         Cursor="Hand" Padding="8,4"
                                         FontSize="10" FontFamily="Consolas">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#2A0A0A"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="MapMarkerOff" Width="11" Height="11"
                                                                VerticalAlignment="Center" Margin="0,0,5,0"
                                                                Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"/>
                                    <TextBlock Text="Zone Moarte" VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"/>
                                </StackPanel>
                            </ToggleButton>
                        </Border>

                        <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="14,2" Opacity="0.6"/>

                        <!-- Meniu Vizualizare — fix după rețea, nu flotant dreapta -->
                        <Border x:Name="OptionsMenuTrigger"
                                MouseEnter="OptionsMenuTrigger_MouseEnter"
                                MouseLeave="OptionsMenuTrigger_MouseLeave"
                                Cursor="Hand" CornerRadius="5" Padding="10,5"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BgHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ViewDashboard" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                                            Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="Vizualizare" FontSize="11" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <iconPacks:PackIconMaterial Kind="ChevronDown" Width="10" Height="10"
                                                            VerticalAlignment="Center" Margin="4,0,0,0"
                                                            Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </Border>

                        <!-- Popup meniu -->
                        <Popup x:Name="OptionsPopup"
                               PlacementTarget="{Binding ElementName=OptionsMenuTrigger}"
                               Placement="Bottom"
                               StaysOpen="True"
                               AllowsTransparency="True">
                            <Border Background="{StaticResource BgPanel}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="5"
                                    MinWidth="220"
                                    MouseEnter="OptionsPopupContent_MouseEnter"
                                    MouseLeave="OptionsPopupContent_MouseLeave">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Label secțiune -->
                                    <TextBlock Text="VIZUALIZARE CENTRALĂ" FontSize="9" FontFamily="Consolas"
                                               FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                                               Margin="10,6,10,4"/>
                                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="5,0,5,4" Opacity="0.5"/>

                                    <!-- Heatmap Normal -->
                                    <Button Style="{StaticResource OptionsMenuItem}"
                                            Click="OptionsMenuNormal_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="LayersTriple" Width="14" Height="14"
                                                                        VerticalAlignment="Center" Margin="0,0,10,0"
                                                                        Foreground="{StaticResource Accent}"/>
                                            <StackPanel>
                                                <TextBlock Text="Heatmap Normal" FontSize="12"/>
                                                <TextBlock Text="Vizualizare semnal curent" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                            <!-- Indicator activ -->
                                            <iconPacks:PackIconMaterial Kind="Check" Width="12" Height="12"
                                                                        VerticalAlignment="Center" Margin="12,0,0,0"
                                                                        Foreground="{StaticResource Accent}"
                                                                        Visibility="{Binding IsNormalViewActive, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Heatmap Optimizat -->
                                    <Button Style="{StaticResource OptionsMenuItem}"
                                            Click="OptionsMenuOptimized_Click"
                                            IsEnabled="{Binding IsOptimizationDone}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="RouterWireless" Width="14" Height="14"
                                                                        VerticalAlignment="Center" Margin="0,0,10,0"
                                                                        Foreground="#22C55E"/>
                                            <StackPanel>
                                                <TextBlock Text="Heatmap Optimizat" FontSize="12"/>
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Simulare router la poziție optimă"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOptimizationDone}" Value="False">
                                                                    <Setter Property="Text" Value="Rulați optimizarea mai întâi"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <iconPacks:PackIconMaterial Kind="Check" Width="12" Height="12"
                                                                        VerticalAlignment="Center" Margin="12,0,0,0"
                                                                        Foreground="#22C55E"
                                                                        Visibility="{Binding IsOptimizedViewActive, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Button>

                                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="5,4,5,4" Opacity="0.5"/>

                                    <!-- Doctor WiFi -->
                                    <Button Style="{StaticResource OptionsMenuItem}"
                                            Click="OptionsMenuDoctor_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Stethoscope" Width="14" Height="14"
                                                                        VerticalAlignment="Center" Margin="0,0,10,0"
                                                                        Foreground="#F97316"/>
                                            <StackPanel>
                                                <TextBlock Text="Doctor WiFi" FontSize="12"/>
                                                <TextBlock Text="Diagnostic rețea cu AI" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                            <iconPacks:PackIconMaterial Kind="Check" Width="12" Height="12"
                                                                        VerticalAlignment="Center" Margin="12,0,0,0"
                                                                        Foreground="#F97316"
                                                                        Visibility="{Binding IsDoctorViewActive, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ WIZARD GHID BASIC MODE — Row 1, sub bara de sus ══ -->
            <Border Grid.Row="1"
                    Visibility="{Binding IsWizardVisible, Converter={StaticResource BoolToVis}}"
                    Background="#12101820"
                    BorderBrush="#3B82F6"
                    BorderThickness="0,0,0,2"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step indicator -->
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                            Background="#1A3B82F6" BorderBrush="#3B82F6" BorderThickness="1.5"
                            Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WizardStepNumber}"
                                   FontSize="8" FontWeight="Bold" Foreground="#93C5FD"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Width="34"/>
                    </Border>

                    <!-- Title + description + progress bar -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{Binding WizardTitle}"
                                       FontSize="12" FontWeight="Bold" Foreground="#E0E8FF"/>
                        </StackPanel>
                        <TextBlock Text="{Binding WizardDescription}"
                                   FontSize="10" Foreground="#93C5FD"
                                   TextWrapping="Wrap"/>
                        <!-- Progress segments — 7 pași -->
                        <UniformGrid Rows="1" Columns="7" Height="3" Margin="0,6,0,0" MaxWidth="300" HorizontalAlignment="Left">
                            <Border Margin="0,0,2,0" CornerRadius="2"
                                    Background="{Binding CurrentWizardStep, Converter={StaticResource WizardStepBrushConverter}, ConverterParameter='0'}"/>
                            <Border Margin="0,0,2,0" CornerRadius="2"
                                    Background="{Binding CurrentWizardStep, Converter={StaticResource WizardStepBrushConverter}, ConverterParameter='1'}"/>
                            <Border Margin="0,0,2,0" CornerRadius="2"
                                    Background="{Binding CurrentWizardStep, Converter={StaticResource WizardStepBrushConverter}, ConverterParameter='2'}"/>
                            <Border Margin="0,0,2,0" CornerRadius="2"
                                    Background="{Binding CurrentWizardStep, Converter={StaticResource WizardStepBrushConverter}, ConverterParameter='3'}"/>
                            <Border Margin="0,0,2,0" CornerRadius="2"
                                    Background="{Binding CurrentWizardStep, Converter={StaticResource WizardStepBrushConverter}, ConverterParameter='4'}"/>
                            <Border Margin="0,0,2,0" CornerRadius="2"
                                    Background="{Binding CurrentWizardStep, Converter={StaticResource WizardStepBrushConverter}, ConverterParameter='5'}"/>
                            <Border CornerRadius="2"
                                    Background="{Binding CurrentWizardStep, Converter={StaticResource WizardStepBrushConverter}, ConverterParameter='6'}"/>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Butoane dreapta: Skip Calibrare (doar la pasul 3) + Action + X -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Buton Skip — vizibil doar la pasul Calibrate (2) și necalibrat -->
                        <Button Command="{Binding SkipCalibrationCommand}"
                                Background="Transparent" Foreground="#6B7280"
                                BorderBrush="#374151" BorderThickness="1"
                                Padding="10,6" Cursor="Hand" FontSize="10"
                                Margin="0,0,8,0"
                                ToolTip="Sari peste calibrare (heatmap-ul va folosi scara implicita de 50px/m)">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1F2937"/>
                                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentWizardStep}" Value="Calibrate"/>
                                                <Condition Binding="{Binding IsCalibrated}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Sari →"/>
                        </Button>

                        <!-- Action button principal -->
                        <Button Command="{Binding ExecuteWizardStepCommand}"
                                Background="#3B82F6" Foreground="White"
                                BorderThickness="0" Padding="16,7"
                                Cursor="Hand" FontSize="11" FontWeight="SemiBold"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2563EB"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding WizardActionText}"/>
                        </Button>

                        <!-- X — închide panoul wizard fără a schimba modul -->
                        <Button Command="{Binding DismissWizardCommand}"
                                Background="Transparent" Foreground="#4B5563"
                                BorderThickness="0" Padding="6,6"
                                Cursor="Hand"
                                ToolTip="Închide ghidul (poate fi redeschis din sidebar)">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="✕" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- ZONA CENTRALĂ — 3 MODURI DE VIZUALIZARE              -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">

                <!-- ══ MOD 1: HEATMAP NORMAL (vizualizare curentă) ══ -->
                <Grid Visibility="{Binding IsNormalViewActive, Converter={StaticResource BoolToVis}}">

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource BgBase}">
                        <Canvas x:Name="MapCanvas"
                                MouseWheel="MapCanvas_MouseWheel"
                                Background="Transparent">

                            <Grid x:Name="MapContent"
                                  MouseLeftButtonDown="MapContent_MouseLeftButtonDown"
                                  MouseRightButtonDown="MapContent_MouseRightButtonDown"
                                  MouseMove="MapContent_MouseMove"
                                  MouseLeftButtonUp="MapContent_MouseLeftButtonUp"
                                  Background="Transparent"
                                  Cursor="Cross">

                                <Border x:Name="GridBackground"
                                        Background="{StaticResource GridBrush}"
                                        Opacity="1" Panel.ZIndex="0"
                                        Visibility="Collapsed" />

                                <Image x:Name="FloorPlanImage"
                                       Source="{Binding FloorPlan}"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" Panel.ZIndex="1"/>

                                <Image Source="{Binding HeatmapOverlay}"
                                       Width="{Binding ElementName=FloorPlanImage, Path=ActualWidth}"
                                       Height="{Binding ElementName=FloorPlanImage, Path=ActualHeight}"
                                       Stretch="Fill" IsHitTestVisible="False" Opacity="0.7" Panel.ZIndex="2"/>

                                <!-- Dead Zone Overlay — zone roșii sub prag -->
                                <Image Source="{Binding DeadZoneOverlay}"
                                       Width="{Binding ElementName=FloorPlanImage, Path=ActualWidth}"
                                       Height="{Binding ElementName=FloorPlanImage, Path=ActualHeight}"
                                       Stretch="Fill" IsHitTestVisible="False" Panel.ZIndex="3"
                                       Visibility="{Binding IsDeadZoneOverlayActive, Converter={StaticResource BoolToVisConverter}}"/>

                                <InkCanvas x:Name="EditorCanvas"
                                           Background="Transparent"
                                           MouseLeftButtonDown="EditorCanvas_MouseDown"
                                           MouseMove="EditorCanvas_MouseMove"
                                           MouseLeftButtonUp="EditorCanvas_MouseUp"
                                           Panel.ZIndex="3"
                                           EditingMode="None">
                                    <InkCanvas.DefaultDrawingAttributes>
                                        <DrawingAttributes Color="#C8D6F0" Height="3" Width="3" FitToCurve="False"/>
                                    </InkCanvas.DefaultDrawingAttributes>
                                </InkCanvas>

                                <Line x:Name="PreviewLine"
                                      Stroke="#3B82F6" StrokeThickness="1.5"
                                      Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="4"/>

                                <Canvas x:Name="SurveyPointsCanvas" Background="Transparent" Panel.ZIndex="5" IsHitTestVisible="False"/>
                                <Canvas x:Name="ObjectsCanvas" Background="{x:Null}" IsHitTestVisible="True" Panel.ZIndex="6"/>
                            </Grid>
                        </Canvas>
                    </ScrollViewer>

                    <!-- Overlay modul desenare -->
                    <Grid x:Name="DrawingOverlayUI" Visibility="Collapsed">
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,16" Background="{StaticResource BgSection}"
                                CornerRadius="6" Padding="14,7"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Panel.ZIndex="200">
                            <TextBlock Text="Selectează materialul din dreapta · Salvează Schița când ești gata"
                                       Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="Consolas"/>
                        </Border>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right"
                                    Orientation="Horizontal" Margin="0,14,24,0"
                                    Panel.ZIndex="200" IsHitTestVisible="True">
                            <Button Click="SaveSketch_Click" Style="{StaticResource AccentButton}" Padding="12,8" Margin="0,0,6,0" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ContentSave" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Salvează Schița" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="CancelSketch_Click" Style="{StaticResource DangerButton}" Padding="12,8" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Anulează" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Comenzi rapide (vizibil când există plan) -->
                    <Border Background="{StaticResource BgSection}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,14" Margin="16"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Visibility="{Binding FloorPlan, Converter={StaticResource InvertNullToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="COMENZI RAPIDE" FontWeight="Bold" FontSize="9"
                                       FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,2" Text="Scroll  →  Zoom In/Out"/>
                            <TextBlock FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,2" Text="Drag    →  Mută harta"/>
                            <TextBlock FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,2" Text="R / Shift+R  →  Rotire"/>
                            <TextBlock FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,2" Text="ESC  →  Resetează poziția"/>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,6" Opacity="0.5"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="4" Height="4" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock FontSize="10" FontFamily="Consolas" Foreground="{StaticResource Accent}"
                                           Text="Click stânga  →  Acțiunea uneltei active"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Legendă heatmap (bottom-left, vizibilă doar când există heatmap) -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="16"
                            Background="{StaticResource BgSection}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10"
                            Panel.ZIndex="50"
                            Visibility="{Binding HeatmapOverlay, Converter={StaticResource InvertNullToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.45"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="SEMNAL WiFi" FontSize="9" FontWeight="Bold" FontFamily="Consolas"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,7"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#00C800" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Excelent  › -50 dBm" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#ADFF00" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bun       -50 / -62" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#FFFF00" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Mediu     -62 / -70" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#FF8000" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Slab      -70 / -80" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#FF0000" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="F. Slab   ‹ -80 dBm" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Empty state (niciun plan) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowEmptyPlaceholder, Converter={StaticResource BoolToVis}}">
                        <Border Width="80" Height="80" CornerRadius="40"
                                Background="#151518" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <iconPacks:PackIconMaterial Kind="FloorPlan" Width="36" Height="36"
                                                       Foreground="#3B82F6"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Niciun plan încărcat"
                                   FontSize="16" FontFamily="Segoe UI" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Folosește panoul din stânga pentru a încărca un plan sau a crea o schiță."
                                   FontSize="11" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                   TextAlignment="Center" MaxWidth="320"/>
                    </StackPanel>
                </Grid>

                <!-- ══ MOD 2: HEATMAP OPTIMIZAT (simulare poziție router optimă) ══ -->
                <Grid Visibility="{Binding IsOptimizedViewActive, Converter={StaticResource BoolToVis}}">

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource BgBase}">
                        <Canvas x:Name="OptimizedMapCanvas" Background="Transparent">
                            <Grid x:Name="OptimizedMapContent" Background="Transparent">
                                <Image x:Name="OptimizedFloorPlanImage"
                                       Source="{Binding FloorPlan}"
                                       Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Panel.ZIndex="1"/>
                                <Image x:Name="OptimizedHeatmapImage"
                                       Source="{Binding OptimizedHeatmapOverlay}"
                                       Width="{Binding ElementName=OptimizedFloorPlanImage, Path=ActualWidth}"
                                       Height="{Binding ElementName=OptimizedFloorPlanImage, Path=ActualHeight}"
                                       Stretch="Fill" IsHitTestVisible="False" Opacity="0.75" Panel.ZIndex="2">
                                    <Image.Effect>
                                        <BlurEffect Radius="6" KernelType="Gaussian"/>
                                    </Image.Effect>
                                </Image>
                                <Canvas x:Name="OptimizedObjectsCanvas" Background="{x:Null}" Panel.ZIndex="3"/>
                            </Grid>
                        </Canvas>
                    </ScrollViewer>

                    <!-- Legendă heatmap optimizat (bottom-left) -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="16"
                            Background="{StaticResource BgSection}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10"
                            Panel.ZIndex="10">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.45"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="SEMNAL SIMULAT" FontSize="9" FontWeight="Bold" FontFamily="Consolas"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,7"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#00C800" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Excelent  › -50 dBm" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#ADFF00" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bun       -50 / -62" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#FFFF00" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Mediu     -62 / -70" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#FF8000" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Slab      -70 / -80" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#FF0000" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="F. Slab   ‹ -80 dBm" FontSize="10" FontFamily="Consolas"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Banner info simulare -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,12,0,0" Background="#0D1A0D"
                            BorderBrush="#22C55E" BorderThickness="1"
                            CornerRadius="6" Padding="14,7" Panel.ZIndex="10">
                        <Border.Effect>
                            <DropShadowEffect Color="#22C55E" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="RouterWireless" Width="14" Height="14"
                                                       Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock FontSize="11" FontFamily="Consolas" Foreground="#22C55E" VerticalAlignment="Center">
                                <Run FontWeight="Bold" Text="SIMULARE"/>
                                <Run Text=" · Heatmap semnal cu routerul la poziția optimă calculată de AI"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- ══ MOD 3: DOCTOR WiFi (diagnostic rețea integrat) ══ -->
                <Grid Visibility="{Binding IsDoctorViewActive, Converter={StaticResource BoolToVis}}">

                    <!-- Raport doctor (când există) -->
                    <views:DoctorPanelView
                        x:Name="DoctorPanel"
                        Report="{Binding DoctorReport}"
                        Visibility="{Binding DoctorReport, Converter={StaticResource InvertNullToVisibilityConverter}}"/>

                    <!-- Se analizează... -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsAnalyzingDoctor, Converter={StaticResource BoolToVis}}">
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="#151518" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#F97316" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <iconPacks:PackIconMaterial Kind="Stethoscope" Width="30" Height="30"
                                                       Foreground="#F97316"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Se analizează rețeaua..."
                                   FontSize="15" FontFamily="Segoe UI" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Machine Learning în desfășurare · K-Means clustering"
                                   FontSize="11" FontFamily="Consolas"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Nicio rețea selectată -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowDoctorNoNetwork, Converter={StaticResource BoolToVis}}">
                        <Border Width="70" Height="70" CornerRadius="35"
                                Background="#151518" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <iconPacks:PackIconMaterial Kind="Stethoscope" Width="32" Height="32"
                                                       Foreground="#3B82F6"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Selectează o rețea pentru diagnostic"
                                   FontSize="16" FontFamily="Segoe UI" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Alege o rețea din panoul din stânga, apoi apasă 'Diagnostichează Rețeaua'"
                                   FontSize="11" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                   TextAlignment="Center" MaxWidth="340"/>
                    </StackPanel>
                </Grid>

            </Grid>
            <!-- ═══════════════════════════════════════════════════════ -->
        </Grid>

        <Border Grid.Column="2"
                Width="210"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsNormalViewActive, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header cu toggle expand/collapse -->
                <ToggleButton x:Name="ToolboxToggle"
                              Grid.Row="0"
                              IsChecked="True"
                              Background="{StaticResource BgSection}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="0,0,0,1"
                              Padding="12,10"
                              Cursor="Hand"
                              Focusable="False">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Rectangle Width="3" Height="12" Fill="{StaticResource Accent}"
                                                   VerticalAlignment="Center" RadiusX="1" RadiusY="1" Margin="0,0,8,0"/>
                                        <TextBlock Text="TRUSA DE UNELTE"
                                                   FontSize="9" FontWeight="Bold" FontFamily="Consolas"
                                                   Foreground="{StaticResource TextMuted}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="arrow" Grid.Column="1"
                                               Text="⌄" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="arrow" Property="Text" Value="›"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsChecked, ElementName=ToolboxToggle, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Margin="8,6,8,16">

                        <TextBlock Text="ACTIUNI" Style="{StaticResource ToolboxSectionLabel}"/>

                        <RadioButton x:Name="ToolSurveyPoint"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     IsChecked="True"
                                     Checked="ToolSurveyPoint_Checked">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="MapMarker" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Punct Masurare" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ToolPointer"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolPointer_Checked">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CursorDefault" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Navigare / Mutare" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="OBSTACOLE · ATENUARE" Style="{StaticResource ToolboxSectionLabel}"/>
                        <Rectangle Style="{StaticResource SectionSep}"/>

                        <RadioButton x:Name="ToolWallConcrete"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="ConcreteWall">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Wall" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Foreground="#787878"/>
                                <TextBlock Text="Zid Beton  -12 dBm" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ToolWallBrick"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="BrickWall">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Wall" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Foreground="#8B4513"/>
                                <TextBlock Text="Caramida  -6 dBm" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ToolDoorWood"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="WoodDoor">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="DoorOpen" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Foreground="#CD853F"/>
                                <TextBlock Text="Usa Lemn  -3 dBm" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <Rectangle Style="{StaticResource SectionSep}" Margin="10,4,10,4"/>

                        <RadioButton x:Name="ToolFridge"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="Fridge">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Fridge" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Foreground="#0064C8"/>
                                <TextBlock Text="Frigider  -15 dBm" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ToolTV"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="TV">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Television" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Foreground="#9600C8"/>
                                <TextBlock Text="Televizor  -5 dBm" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ToolMicrowave"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="Microwave">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Microwave" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Foreground="#C83232"/>
                                <TextBlock Text="Microunde  -8 dBm" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="ECHIPAMENTE RETEA" Style="{StaticResource ToolboxSectionLabel}"/>
                        <Rectangle Style="{StaticResource SectionSep}"/>

                        <RadioButton x:Name="ToolRouter"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="Router">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="RouterWireless" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="Router Virtual" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="SCHITA ARHITECTURALA" Style="{StaticResource ToolboxSectionLabel}"/>
                        <Rectangle Style="{StaticResource SectionSep}"/>

                        <RadioButton x:Name="ToolDrawWall"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolDrawWall_Checked">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Pencil" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Perete (liber)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ToolDrawLine"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolDrawLine_Checked">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="VectorLine" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Linie Dreapta" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ToolEraser"
                                     GroupName="ActiveTool"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolEraser_Checked">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Eraser" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Radiera" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- PANOU DREAPTA — ANALIZĂ AI (vizibil doar în modul Optimizat)    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="2"
                Width="230"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsOptimizedViewActive, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgSection}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="12,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Rectangle Width="3" Height="12" Fill="{StaticResource Accent}"
                                   VerticalAlignment="Center" RadiusX="1" RadiusY="1" Margin="0,0,8,0"/>
                        <TextBlock Text="ANALIZĂ AI OPTIMIZARE"
                                   FontSize="9" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8,10,16"
                                Visibility="{Binding HasCompareStats, Converter={StaticResource BoolToVisConverter}}">

                        <!-- ── SCOR GENERAL AI ─────────────────────────────── -->
                        <Border Background="{StaticResource BgSection}" CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="10,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SCOR OPTIMIZARE" FontSize="8" FontWeight="Bold"
                                               FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AfterStats.OverallScore, StringFormat='{}{0:F0}'}"
                                                   FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                                   Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="/100" FontSize="12" FontFamily="Consolas"
                                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <!-- bara progres fixa (nu depinde de converter) -->
                                    <Grid Height="4" Margin="0,4,0,0">
                                        <Border CornerRadius="2" Background="#1A1A28"/>
                                        <Border x:Name="ScoreProgressBar" CornerRadius="2" Background="{StaticResource Accent}"
                                                HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                                <!-- Litera scor -->
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8"
                                        Background="{StaticResource Accent}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding AfterStats.ScoreGrade}"
                                               FontSize="18" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ── DISTRIBUȚIE SEMNAL ──────────────────────────── -->
                        <TextBlock Text="DISTRIBUȚIE SEMNAL" FontSize="8" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>

                        <!-- Excelent -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Excelent" FontSize="9" FontFamily="Consolas"
                                       Foreground="#22C55E" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="8" CornerRadius="2" Background="#1A1A28" VerticalAlignment="Center" Margin="4,0">
                                <Border x:Name="BarExcellent" Height="8" CornerRadius="2" Background="#22C55E" HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="#22C55E"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding AfterStats.ExcellentPercent, StringFormat='{}{0:F0}%'}"/>
                        </Grid>

                        <!-- Bun -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bun" FontSize="9" FontFamily="Consolas"
                                       Foreground="#A3E635" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="8" CornerRadius="2" Background="#1A1A28" VerticalAlignment="Center" Margin="4,0">
                                <Border x:Name="BarGood" Height="8" CornerRadius="2" Background="#A3E635" HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="#A3E635"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding AfterStats.GoodPercent, StringFormat='{}{0:F0}%'}"/>
                        </Grid>

                        <!-- Mediu -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mediu" FontSize="9" FontFamily="Consolas"
                                       Foreground="#EAB308" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="8" CornerRadius="2" Background="#1A1A28" VerticalAlignment="Center" Margin="4,0">
                                <Border x:Name="BarFair" Height="8" CornerRadius="2" Background="#EAB308" HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="#EAB308"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding AfterStats.FairPercent, StringFormat='{}{0:F0}%'}"/>
                        </Grid>

                        <!-- Slab -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Slab" FontSize="9" FontFamily="Consolas"
                                       Foreground="#F97316" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="8" CornerRadius="2" Background="#1A1A28" VerticalAlignment="Center" Margin="4,0">
                                <Border x:Name="BarPoor" Height="8" CornerRadius="2" Background="#F97316" HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="#F97316"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding AfterStats.PoorPercent, StringFormat='{}{0:F0}%'}"/>
                        </Grid>

                        <!-- Fără semnal -->
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fără" FontSize="9" FontFamily="Consolas"
                                       Foreground="#EF4444" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="8" CornerRadius="2" Background="#1A1A28" VerticalAlignment="Center" Margin="4,0">
                                <Border x:Name="BarDead" Height="8" CornerRadius="2" Background="#EF4444" HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="#EF4444"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding AfterStats.DeadZonePercent, StringFormat='{}{0:F0}%'}"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Opacity="0.4" Margin="0,0,0,8"/>

                        <!-- ── COMPARAȚIE ÎNAINTE / DUPĂ ────────────────────── -->
                        <TextBlock Text="COMPARAȚIE ÎNAINTE / DUPĂ" FontSize="8" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Metric" FontSize="8" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Grid.Column="1" Text="Înaint." FontSize="8" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="După" FontSize="8" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Δ" FontSize="8" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,0,0,4"/>

                        <!-- Acoperire -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="40"/><ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Acoperire" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding BeforeStats.CoveragePercent, StringFormat='{}{0:F0}%'}"/>
                            <TextBlock Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="#22C55E" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding AfterStats.CoveragePercent, StringFormat='{}{0:F0}%'}"/>
                            <TextBlock Grid.Column="3" FontSize="9" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding CoverageDelta, StringFormat='{}{0:+0;-0;0}%'}">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding CoverageDelta, Converter={StaticResource SignConverter}}" Value="-1">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Excelent -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="40"/><ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Excelent" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding BeforeStats.ExcellentPercent, StringFormat='{}{0:F0}%'}"/>
                            <TextBlock Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="#22C55E" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding AfterStats.ExcellentPercent, StringFormat='{}{0:F0}%'}"/>
                            <TextBlock Grid.Column="3" FontSize="9" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding ExcellentDelta, StringFormat='{}{0:+0;-0;0}%'}">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding ExcellentDelta, Converter={StaticResource SignConverter}}" Value="-1">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Semnal mediu -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="40"/><ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sig. mediu" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding BeforeStats.AverageSignal, StringFormat='{}{0:F0}'}"/>
                            <TextBlock Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="#22C55E" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding AfterStats.AverageSignal, StringFormat='{}{0:F0}'}"/>
                            <TextBlock Grid.Column="3" FontSize="9" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding SignalDelta, StringFormat='{}{0:+0;-0;0}'}">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding SignalDelta, Converter={StaticResource SignConverter}}" Value="-1">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Zone moarte -->
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="40"/><ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Zone moarte" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding BeforeStats.DeadZonePercent, StringFormat='{}{0:F0}%'}"/>
                            <TextBlock Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="#22C55E" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding AfterStats.DeadZonePercent, StringFormat='{}{0:F0}%'}"/>
                            <TextBlock Grid.Column="3" FontSize="9" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding DeadZoneDelta, StringFormat='{}{0:+0;-0;0}%'}">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding DeadZoneDelta, Converter={StaticResource SignConverter}}" Value="-1">
                                        <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Opacity="0.4" Margin="0,0,0,8"/>

                        <!-- ── METRICI AVANSATE (extra față de Ekahau) ────────── -->
                        <TextBlock Text="METRICI AVANSATE" FontSize="8" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Viteză est. după" FontSize="9" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="9" FontFamily="Consolas" Foreground="#22C55E" FontWeight="SemiBold"
                                       Text="{Binding AfterStats.EstimatedThroughputMbps, StringFormat='{}{0:F0} Mbps'}"/>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Viteză est. înainte" FontSize="9" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"
                                       Text="{Binding BeforeStats.EstimatedThroughputMbps, StringFormat='{}{0:F0} Mbps'}"/>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Uniformitate" FontSize="9" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                       ToolTip="Cât de uniform e semnalul în toată zona acoperită. 100% = semnal identic peste tot."/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock FontSize="9" FontFamily="Consolas" Foreground="#A3E635" FontWeight="SemiBold"
                                           Text="{Binding AfterStats.UniformityScore, StringFormat='{}{0:F0}%'}"/>
                                <TextBlock FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="3,0,0,0"
                                           Text="{Binding UniformityDelta, StringFormat='({0:+0;-0;0}%)'}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pereți traversați" FontSize="9" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                       ToolTip="Nr. mediu de pereți pe care semnalul îi traversează. Mai puțin = atenuare mai mică."/>
                            <TextBlock Grid.Column="1" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMuted}"
                                       Text="{Binding AfterStats.AvgWallCount, StringFormat='{}{0:F1}'}"/>
                        </Grid>

                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain viteză AI" FontSize="9" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                       ToolTip="Creșterea vitezei estimate față de poziția inițială a routerului."/>
                            <TextBlock Grid.Column="1" FontSize="9" FontFamily="Consolas" FontWeight="Bold"
                                       Text="{Binding ThroughputDelta, StringFormat='{}{0:+0;-0;0} Mbps'}">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding ThroughputDelta, Converter={StaticResource SignConverter}}" Value="-1">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Confidență AI -->
                        <Border Background="#0A0A14" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="CONFIDENȚA AI" FontSize="8" FontWeight="Bold"
                                           FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                                <TextBlock FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap">
                                    <Run Text="{Binding AfterStats.TotalSamples, StringFormat='{}{0:N0}'}"/>
                                    <Run Text=" eșantioane evaluate · Log-Distance Path Loss + Raycasting"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</Window>