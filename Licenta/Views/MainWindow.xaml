<Window x:Class="WifiSignalOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WiFi Signal Optimizer"
        Height="820" Width="1400"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Grid brush pentru drawing overlay -->
        <DrawingBrush x:Key="GridBrush" Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2A2A2A" Thickness="0.5"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,20,20"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- STYLE TOOLBOX RADIOBUTTON — aspect de buton    -->
        <!-- Click → rămâne "apăsat" (highlight albastru)   -->
        <!-- ═══════════════════════════════════════════════ -->
        <Style x:Key="ToolboxButton" TargetType="RadioButton">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="Padding"                  Value="10,6"/>
            <Setter Property="Margin"                   Value="0,1"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <!-- Unealta activă → highlight albastru discret -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgActive}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label secțiune toolbox -->
        <Style x:Key="ToolboxSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Foreground"   Value="{StaticResource TextDisabled}"/>
            <Setter Property="Margin"       Value="10,10,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <!-- Sidebar stânga -->
            <ColumnDefinition Width="*"/>
            <!-- Hartă centru  -->
            <ColumnDefinition Width="220"/>
            <!-- Toolbox dreapta -->
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- COL 0 — SIDEBAR STÂNGA                                      -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{StaticResource BgPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSection}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="WiFi Signal Optimizer"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI"/>
                        <TextBlock Text="Proiect Licență"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Mode Toggle -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgBase}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Padding="0,6" Margin="2" Cursor="Hand"
                            BorderThickness="0" Click="SetBasicMode_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent">
                                                <TextBlock x:Name="txt" Text="BASIC"
                                                           FontSize="11" FontWeight="Bold"
                                                           FontFamily="Segoe UI"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#9D9D9D"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsExpertMode}" Value="False">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Padding="0,6" Margin="2" Cursor="Hand"
                            BorderThickness="0" Click="SetExpertMode_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent">
                                                <TextBlock x:Name="txt" Text="EXPERT"
                                                           FontSize="11" FontWeight="Bold"
                                                           FontFamily="Segoe UI"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#9D9D9D"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Scrollable content -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,4,0,4">

                    <!-- SECȚIUNEA: HARTĂ -->
                    <Expander Style="{StaticResource SidebarExpander}" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="HARTĂ" FontSize="11" FontFamily="Segoe UI"
                                       FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="8,4,8,8">
                            <Button Content="  📂  Încarcă Plan"
                                    Style="{StaticResource SidebarButton}"
                                    Command="{Binding LoadMapCommand}"/>
                            <Button Content="  ✏️  Creează Schiță Nouă"
                                    Style="{StaticResource SidebarButton}"
                                    Click="StartSketch_Click"/>
                            <Button Content="  📏  Calibrează Scara"
                                    Click="StartCalibration_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Calibration status dot -->
                            <Border Margin="4,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Danger}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="11" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondary}"
                                               Text="{Binding PixelsPerMeter, StringFormat='Scară: {0:F1} px/m'}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,2"/>

                    <!-- SECȚIUNEA: SCANARE WiFi -->
                    <Expander Style="{StaticResource SidebarExpander}" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="SCANARE WiFi" FontSize="11" FontFamily="Segoe UI"
                                       FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="8,4,8,8">
                            <Button Content="  📡  Scanează Rețele"
                                    Style="{StaticResource SidebarButton}"
                                    Command="{Binding ScanCommand}"
                                    IsEnabled="{Binding IsScanning, Converter={StaticResource InvertBoolConverter}}"/>
                            <Button Content="  🩺  Diagnostichează Rețeaua"
                                    Style="{StaticResource SidebarButton}"
                                    Command="{Binding AnalyzeNetworkCommand}"/>
                            <Button Content="{Binding AutoScanButtonText}"
                                    Command="{Binding ToggleAutoScanCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAutoScanning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Margin="4,6,0,0" FontSize="11" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextSecondary}"
                                       Text="{Binding SurveyPointCount, StringFormat='  {0} puncte înregistrate'}"/>

                            <!-- Lista Basic: nume + bara -->
                            <Border Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Rețele detectate" FontSize="10" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondary}" Margin="2,0,0,4"/>
                                    <ListBox ItemsSource="{Binding VisibleNetworks}"
                                             SelectedItem="{Binding SelectedNetwork}"
                                             Background="Transparent" BorderThickness="0"
                                             MaxHeight="200"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource NetworkItemBasic}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="📶"
                                                               FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SSID}"
                                                               FontSize="12" FontFamily="Segoe UI"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Grid.Column="2"
                                                                 Value="{Binding SignalQuality, Mode=OneWay}"
                                                                 Height="4" VerticalAlignment="Center"
                                                                 Margin="6,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- Tabel Expert: dBm + canal -->
                            <Border Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DataGrid ItemsSource="{Binding VisibleNetworks}"
                                          SelectedItem="{Binding SelectedNetwork}"
                                          MaxHeight="200" FontFamily="Consolas" FontSize="11">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SSID" Binding="{Binding SSID}" Width="*"/>
                                        <DataGridTextColumn Header="dBm"  Binding="{Binding SignalStrength}" Width="40"/>
                                        <DataGridTextColumn Header="Ch"   Binding="{Binding Channel}" Width="30"/>
                                        <DataGridTemplateColumn Header="Sig" Width="42">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ProgressBar Value="{Binding SignalQuality, Mode=OneWay}"
                                                                 Height="4" Margin="2,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,2"/>

                    <!-- SECȚIUNEA: ANALIZĂ AVANSATĂ (Expert only) -->
                    <Expander IsExpanded="False">
                        <Expander.Style>
                            <Style TargetType="Expander" BasedOn="{StaticResource SidebarExpander}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpertMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <TextBlock Text="ANALIZĂ AVANSATĂ" FontSize="11" FontFamily="Segoe UI"
                                       FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="8,4,8,8">
                            <Button Content="  🔥  Generează Heatmap"
                                    Style="{StaticResource SidebarButton}"
                                    Command="{Binding GenerateHeatmapCommand}"/>
                            <Button Content="  ⭐  Poziție Optimă Router (Min-Max)"
                                    Style="{StaticResource SidebarButton}"
                                    Command="{Binding CalculateOptimalRouterCommand}"
                                    ToolTip="Algoritmul Min-Max garantează semnal uniform în toată casa."/>
                        </StackPanel>
                    </Expander>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,2"/>

                    <!-- SECȚIUNEA: PROIECT -->
                    <Expander Style="{StaticResource SidebarExpander}" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="PROIECT" FontSize="11" FontFamily="Segoe UI"
                                       FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                       Margin="4,0,0,0"/>
                        </Expander.Header>
                        <StackPanel Margin="8,4,8,8">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="  💾  Salvare"
                                        Style="{StaticResource AccentButton}"
                                        Command="{Binding SaveProjectCommand}" Padding="8,7"/>
                                <Button Grid.Column="2" Content="  📥  Încărcare"
                                        Style="{StaticResource SidebarButton}"
                                        Command="{Binding LoadProjectCommand}" Padding="8,7"/>
                            </Grid>
                            <Button Content="  🗑️  Șterge Toate Punctele"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding ClearSurveyPointsCommand}"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{StaticResource Accent}" Padding="10,4">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontFamily="Segoe UI"
                           Foreground="White" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- COL 1 — ZONA PRINCIPALĂ: HARTĂ                             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{StaticResource BgBase}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar hartă -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSection}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Hartă Plan de Încadrare" FontSize="13" FontFamily="Segoe UI"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="14,0"/>
                    <TextBlock Text="{Binding SurveyPointCount, StringFormat='{}{0} puncte'}"
                               FontSize="11" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <!-- Indicator unealtă activă -->
                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="14,0"/>
                    <TextBlock x:Name="ActiveToolLabel"
                               Text="● Punct Măsurare activ"
                               FontSize="11" FontFamily="Segoe UI"
                               Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Canvas hartă -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource BgBase}">
                <Canvas x:Name="MapCanvas"
                        MouseWheel="MapCanvas_MouseWheel"
                        Background="Transparent">
                    <Grid x:Name="MapContent"
                          MouseLeftButtonDown="MapContent_MouseLeftButtonDown"
                          MouseRightButtonDown="MapContent_MouseRightButtonDown"
                          MouseMove="MapContent_MouseMove"
                          MouseLeftButtonUp="MapContent_MouseLeftButtonUp"
                          Background="Transparent"
                          Cursor="Cross">

                        <Image x:Name="FloorPlanImage"
                               Source="{Binding FloorPlan}"
                               Stretch="None"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>

                        <Image Source="{Binding HeatmapOverlay}"
                               Width="{Binding ElementName=FloorPlanImage, Path=ActualWidth}"
                               Height="{Binding ElementName=FloorPlanImage, Path=ActualHeight}"
                               Stretch="Fill" IsHitTestVisible="False" Opacity="0.7"/>

                        <Canvas x:Name="SurveyPointsCanvas" Background="Transparent" Panel.ZIndex="1"/>

                        <!-- Canvas pentru obstacole/echipamente — vizibil întotdeauna pe hartă -->
                        <Canvas x:Name="ObjectsCanvas"
                                Background="{x:Null}"
                                IsHitTestVisible="True"
                                Panel.ZIndex="5"/>
                    </Grid>
                </Canvas>
            </ScrollViewer>

            <!-- DRAWING OVERLAY (modul schiță) -->
            <Grid x:Name="DrawingOverlay"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Background="{StaticResource BgBase}">

                <Border Background="{StaticResource GridBrush}" Opacity="0.4" Panel.ZIndex="0"/>

                <InkCanvas x:Name="EditorCanvas"
                           Background="Transparent"
                           MouseLeftButtonDown="EditorCanvas_MouseDown"
                           MouseMove="EditorCanvas_MouseMove"
                           MouseLeftButtonUp="EditorCanvas_MouseUp"
                           Panel.ZIndex="1">
                    <InkCanvas.DefaultDrawingAttributes>
                        <DrawingAttributes Color="#D4D4D4" Height="3" Width="3" FitToCurve="False"/>
                    </InkCanvas.DefaultDrawingAttributes>
                </InkCanvas>

                <Line x:Name="PreviewLine"
                      Stroke="#007ACC" StrokeThickness="1.5"
                      Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="100"/>

                <!-- Hint bottom -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,12"
                        Background="{StaticResource BgSection}"
                        CornerRadius="4" Padding="12,6"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Panel.ZIndex="200">
                    <TextBlock Text="Folosește uneltele din dreapta · Salvează Schița când ești gata"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" FontFamily="Segoe UI"/>
                </Border>

                <!-- Butoane Salvează / Anulează în Drawing Overlay -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Margin="0,12,12,0" Panel.ZIndex="200">
                    <Button Content="  💾  Salvează Schița"
                            Click="SaveSketch_Click"
                            Style="{StaticResource AccentButton}"
                            Padding="12,7" Margin="0,0,6,0" FontSize="12"/>
                    <Button Content="  ✕  Anulează"
                            Click="CancelSketch_Click"
                            Style="{StaticResource DangerButton}"
                            Padding="12,7" FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- Keyboard shortcuts (când e plan încărcat) -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgSection}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="16,14" Margin="20"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Visibility="{Binding FloorPlan, Converter={StaticResource InvertNullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="COMENZI RAPIDE" FontWeight="Bold" FontSize="10"
                               FontFamily="Segoe UI" Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,8"/>
                    <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondary}" Margin="0,2" Text="Scroll  →  Zoom In/Out"/>
                    <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondary}" Margin="0,2" Text="Drag    →  Mută harta"/>
                    <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondary}" Margin="0,2" Text="R / Shift+R  →  Rotire"/>
                    <TextBlock FontSize="11" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondary}" Margin="0,2" Text="ESC  →  Resetează poziția"/>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,6"/>
                    <TextBlock FontSize="11" FontFamily="Segoe UI"
                               Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                               Text="Click stânga  →  Acțiunea unealtei active"/>
                </StackPanel>
            </Border>

            <!-- Placeholder când nu e niciun plan -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding FloorPlan, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Niciun plan încărcat" FontSize="18" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                <TextBlock Text="Folosește panoul din stânga pentru a încărca un plan sau a crea o schiță nouă."
                           FontSize="12" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextDisabled}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           TextAlignment="Center" MaxWidth="340"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- COL 2 — TOOLBOX DREAPTA (vizibil întotdeauna)              -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="2"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbox header -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgSection}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="10,10">
                    <TextBlock Text="TRUSĂ DE UNELTE"
                               FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,8,12">

                        <!-- ── ACȚIUNI DE BAZĂ ── -->
                        <TextBlock Text="ACȚIUNI" Style="{StaticResource ToolboxSectionLabel}"/>

                        <RadioButton x:Name="ToolSurveyPoint"
                                     GroupName="ActiveTool"
                                     Content="  📍  Punct Măsurare"
                                     Style="{StaticResource ToolboxButton}"
                                     IsChecked="True"
                                     Checked="ToolSurveyPoint_Checked"/>

                        <RadioButton x:Name="ToolPointer"
                                     GroupName="ActiveTool"
                                     Content="  🖱️  Navigare / Mutare"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolPointer_Checked"/>

                        <!-- ── OBSTACOLE ── -->
                        <TextBlock Text="OBSTACOLE · ATENUARE" Style="{StaticResource ToolboxSectionLabel}"
                                   Margin="10,12,0,4"/>
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="10,0,10,6"/>

                        <RadioButton x:Name="ToolWallConcrete"
                                     GroupName="ActiveTool"
                                     Content="  🧱  Zid Beton  −12 dBm"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="ConcreteWall"/>

                        <RadioButton x:Name="ToolWallBrick"
                                     GroupName="ActiveTool"
                                     Content="  🧱  Cărămidă  −6 dBm"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="BrickWall"/>

                        <RadioButton x:Name="ToolDoorWood"
                                     GroupName="ActiveTool"
                                     Content="  🚪  Ușă Lemn  −3 dBm"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="WoodDoor"/>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="10,6"/>

                        <RadioButton x:Name="ToolFridge"
                                     GroupName="ActiveTool"
                                     Content="  ❄️  Frigider  −15 dBm"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="Fridge"/>

                        <RadioButton x:Name="ToolTV"
                                     GroupName="ActiveTool"
                                     Content="  📺  Televizor  −5 dBm"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="TV"/>

                        <RadioButton x:Name="ToolMicrowave"
                                     GroupName="ActiveTool"
                                     Content="  📻  Microunde  −8 dBm"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="Microwave"/>

                        <!-- ── ECHIPAMENTE ── -->
                        <TextBlock Text="ECHIPAMENTE REȚEA" Style="{StaticResource ToolboxSectionLabel}"
                                   Margin="10,12,0,4"/>
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="10,0,10,6"/>

                        <RadioButton x:Name="ToolRouter"
                                     GroupName="ActiveTool"
                                     Content="  📡  Router Virtual"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolObstacle_Checked" Tag="Router"/>

                        <!-- ── SCHIȚĂ (vizibil când DrawingOverlay e activ) ── -->
                        <TextBlock Text="SCHIȚĂ ARHITECTURALĂ" Style="{StaticResource ToolboxSectionLabel}"
                                   Margin="10,12,0,4"/>
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="10,0,10,6"/>

                        <RadioButton x:Name="ToolDrawWall"
                                     GroupName="ActiveTool"
                                     Content="  ✏️  Perete (liber)"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolDrawWall_Checked"/>

                        <RadioButton x:Name="ToolDrawLine"
                                     GroupName="ActiveTool"
                                     Content="  📐  Linie Dreaptă"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolDrawLine_Checked"/>

                        <RadioButton x:Name="ToolEraser"
                                     GroupName="ActiveTool"
                                     Content="  🧹  Radieră"
                                     Style="{StaticResource ToolboxButton}"
                                     Checked="ToolEraser_Checked"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</Window>
