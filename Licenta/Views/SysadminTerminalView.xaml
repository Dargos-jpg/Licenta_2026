<UserControl x:Class="WifiSignalOptimizer.Views.SysadminTerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#0A0A0E">

    <UserControl.Resources>
        <!-- terminal color palette -->
        <SolidColorBrush x:Key="TBg"         Color="#0A0A0E"/>
        <SolidColorBrush x:Key="TBgCard"     Color="#101015"/>
        <SolidColorBrush x:Key="TBorder"     Color="#1E1E2E"/>
        <SolidColorBrush x:Key="TPrompt"     Color="#3B82F6"/>
        <SolidColorBrush x:Key="TOutput"     Color="#C0C0D8"/>
        <SolidColorBrush x:Key="TSuccess"    Color="#4ADE80"/>
        <SolidColorBrush x:Key="TError"      Color="#F87171"/>
        <SolidColorBrush x:Key="TWarning"    Color="#FBBF24"/>
        <SolidColorBrush x:Key="TInfo"       Color="#60A5FA"/>
        <SolidColorBrush x:Key="TMuted"      Color="#3A3A52"/>
        <SolidColorBrush x:Key="TCommand"    Color="#E879F9"/>

        <!-- slim inline scrollbar (4 px, no arrows) -->
        <Style x:Key="TermScrollBar" TargetType="ScrollBar">
            <Setter Property="Width"      Value="4"/>
            <Setter Property="MinWidth"   Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="th" Background="#2A2A3E" CornerRadius="2" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="th" Property="Background" Value="#3B82F6"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="th" Property="Background" Value="#60A5FA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- suggestion item style -->
        <Style x:Key="SuggestionItem" TargetType="ListBoxItem">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#A0A0C0"/>
            <Setter Property="FontFamily"  Value="Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Padding"     Value="10,4"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#141428"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- action button base style -->
        <Style x:Key="TermBtn" TargetType="Button">
            <Setter Property="Background"       Value="#141420"/>
            <Setter Property="Foreground"       Value="#7070A0"/>
            <Setter Property="BorderBrush"      Value="#2A2A3E"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="10,0"/>
            <Setter Property="Height"           Value="28"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="FontSize"         Value="10"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"   Value="#1E1E2E"/>
                                <Setter TargetName="bg" Property="BorderBrush"  Value="#3A3A52"/>
                                <Setter Property="Foreground" Value="#A0A0C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0A0A14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- info bar -->
            <RowDefinition Height="*"/>      <!-- output -->
            <RowDefinition Height="Auto"/>   <!-- suggestions -->
            <RowDefinition Height="Auto"/>   <!-- input row -->
        </Grid.RowDefinitions>

        <!-- ── info bar ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#0D0D14"
                BorderBrush="{StaticResource TBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- terminal icon + title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Console" Width="13" Height="13"
                                               Foreground="#3B82F6" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                    <TextBlock Text="Network Terminal" FontFamily="Segoe UI" FontSize="11"
                               FontWeight="SemiBold" Foreground="#6060A0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbHostname" FontFamily="Cascadia Code, Consolas"
                               FontSize="10" Foreground="#3B82F6" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <!-- connection status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6"
                             Fill="#4ADE80" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbConnected" Text="Connected"
                               FontFamily="Segoe UI" FontSize="10"
                               Foreground="#4ADE80" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbInterface" FontFamily="Cascadia Code, Consolas"
                               FontSize="10" Foreground="#3A3A52"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── output (RichTextBox) ─────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" x:Name="OutputScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#0A0A0E"
                      Padding="0">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource TermScrollBar}"/>
            </ScrollViewer.Resources>

            <RichTextBox x:Name="OutputBox"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="12"
                         Foreground="{StaticResource TOutput}"
                         Padding="14,10"
                         IsDocumentEnabled="True"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled">
                <FlowDocument PagePadding="0" LineHeight="18">
                    <!-- content added in code-behind -->
                </FlowDocument>
            </RichTextBox>
        </ScrollViewer>

        <!-- ── suggestions popup ────────────────────────────────────────── -->
        <Border Grid.Row="2" x:Name="SuggestionsPanel"
                Background="#0D0D14"
                BorderBrush="{StaticResource TBorder}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <ListBox x:Name="SuggestionsList"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="120"
                     ItemContainerStyle="{StaticResource SuggestionItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     SelectionChanged="SuggestionsList_SelectionChanged">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TermScrollBar}"/>
                </ListBox.Resources>
            </ListBox>
        </Border>

        <!-- ── input row ─────────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="#0D0D14"
                BorderBrush="{StaticResource TBorder}"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- prompt -->
                    <ColumnDefinition Width="*"/>     <!-- input -->
                    <ColumnDefinition Width="Auto"/>  <!-- buttons -->
                </Grid.ColumnDefinitions>

                <!-- prompt label -->
                <TextBlock Grid.Column="0"
                           Text="net ❯ "
                           FontFamily="Cascadia Code, Consolas"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TPrompt}"
                           VerticalAlignment="Center"
                           Margin="4,0,2,0"/>

                <!-- command input -->
                <TextBox Grid.Column="1" x:Name="InputBox"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="12"
                         Foreground="#D0D0F0"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="#3B82F6"
                         SelectionBrush="#1E3A5F"
                         VerticalAlignment="Center"
                         PreviewKeyDown="InputBox_PreviewKeyDown"
                         TextChanged="InputBox_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="0"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,4,0">
                    <Button x:Name="BtnRun" Content="↵ Run"
                            Style="{StaticResource TermBtn}"
                            BorderBrush="#1E3A5F" Foreground="#60A5FA"
                            Margin="0,0,4,0"
                            Click="BtnRun_Click"/>
                    <Button x:Name="BtnStop" Content="⏹ Stop"
                            Style="{StaticResource TermBtn}"
                            BorderBrush="#3A1818" Foreground="#F87171"
                            Margin="0,0,4,0"
                            IsEnabled="False"
                            Click="BtnStop_Click"/>
                    <Button x:Name="BtnClear" Content="✕ Clear"
                            Style="{StaticResource TermBtn}"
                            Click="BtnClear_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
